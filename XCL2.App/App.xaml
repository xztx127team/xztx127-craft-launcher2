<Application x:Class="XCL2.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:XCL2.App.Services"
             xmlns:models="clr-namespace:XCL2.App.Models">
    <!-- StartupUri 移除：改由 Program.cs 里自定义的 Main 入口先做 .NET8 运行时前置检测，
         检测通过后才 new App().Run(new MainWindow())，保证"你需要安装 .NET8 运行时才可以
         继续使用本程序"这句中文提示能在窗口真正创建前弹出，而不是等 WPF 初始化过程中途
         才失败。 -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- 科技感配色：冷调主蓝 + 青色高亮，白底不变。
                 AccentBrush 从原来偏暖的 #2F76E0 换成更冷更亮的 #1868E8，
                 新增 GlowBrush(#00D4FF 青) 用于 focus/hover 发光描边和数据强调色，
                 边框从纯灰 #DCE2EA 换成半透明蓝灰，让描边看起来像"电路线"而不是普通表单框线。 -->
            <SolidColorBrush x:Key="AccentBrush" Color="#1868E8"/>
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#0F52C4"/>
            <!-- 按钮背景专用的浅蓝色：之前所有按钮（PrimaryButton + 隐式默认 Button 样式）
                 都直接拿 AccentBrush(#1868E8，深蓝) 当背景 + 白字，界面上大片按钮堆在一起
                 视觉很扎眼、压得慌。这里单独拆出一组"浅蓝底 + 深色字"的按钮专用配色，
                 不动 AccentBrush 本身——AccentBrush 还继续用作强调文字色/描边色/焦点色等
                 场景（SecondaryButton 文字、输入框光标、选中态描边等），只有按钮的背景
                 换成这一套更柔和的浅色，两者互不影响。 -->
            <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#CDE2FA"/>
            <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#B3D3F7"/>
            <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#0A356F"/>
            
            <SolidColorBrush x:Key="SoftHeaderBrush" Color="#CDE2FA"/>
            <SolidColorBrush x:Key="SoftHeaderForegroundBrush" Color="#0A356F"/>
            <SolidColorBrush x:Key="GlowBrush" Color="#00C2E8"/>
            <SolidColorBrush x:Key="GlowSoftBrush" Color="#E3F7FC"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SideBrush" Color="#F3F6FA"/>
            <SolidColorBrush x:Key="BorderBrush2" Color="#BCCBDB"/>
            <SolidColorBrush x:Key="BorderHoverBrush" Color="#7FA7D8"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0B1220"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#465568"/>

            
            <SolidColorBrush x:Key="PopupPanelBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PopupTextPrimaryBrush" Color="#0B1220"/>
            <BlurEffect x:Key="PopupBlurEffect" Radius="0"/>
            <SolidColorBrush x:Key="DrawerBackgroundBrush" Color="#F3F6FA"/>
            <SolidColorBrush x:Key="DrawerTextPrimaryBrush" Color="#0B1220"/>
            <BlurEffect x:Key="DrawerBlurEffect" Radius="0"/>

            
            <SolidColorBrush x:Key="TileBadgeBlueBrush" Color="#E3F7FC"/>
            <SolidColorBrush x:Key="TileBadgeIndigoBrush" Color="#EAF1FF"/>
            <SolidColorBrush x:Key="TileBadgeGreenBrush" Color="#E7F6EC"/>
            <SolidColorBrush x:Key="TileBadgeOrangeBrush" Color="#FFF1E3"/>
            <SolidColorBrush x:Key="TileBadgePurpleBrush" Color="#F1E9FF"/>
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#1E9E4F"/>
            <SolidColorBrush x:Key="WarningTextBrush" Color="#D9822B"/>
            <SolidColorBrush x:Key="WarningBannerBrush" Color="#FFF7E6"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#D64545"/>
            <!-- 细分隔线/步骤圆点用的中性灰边框，之前很多地方直接写死 #DDDDDD/#E0E0E0/#EEEEEE，
                 同样的"只在白皮肤下能看清"问题，改成跟随皮肤的资源。 -->
            <SolidColorBrush x:Key="DividerBrush" Color="#D2DAE4"/>
            <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

            <!-- 卡片内联展开（仿 PCL）通用：IsExpanded/IsLoadingVersions 都是 bool，
                 直接用 WPF 内置转换器绑定到 Visibility，不需要自己写 IValueConverter。 -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <models:ScreenHeightFractionConverter x:Key="ScreenHeightFractionConverter"/>

            <!-- 通用 focus/hover 发光效果：细而亮的青色描边光晕，替代原来大面积色块高亮，
                 科技感界面里更常见"边缘发光"而不是"整块填色"。控件模板里用
                 <Border.Effect><StaticResource GlowEffect"/></Border.Effect> 引用。 -->
            <DropShadowEffect x:Key="GlowEffect" Color="#00C2E8" BlurRadius="10" ShadowDepth="0" Opacity="0.55"/>

            <!-- 胶囊开关按钮：原来只在 HomePage.xaml 里当局部资源定义（首页右上角"深/浅色、
                 自动循环、高级模式、访客模式"那一排），这里挪到全局资源，方便任何窗口/页面
                 复用同一套"未开启=描边小胶囊、开启=强调色填充"的视觉语言（比如 AgreementsWindow
                 的"人话版"开关），不需要每个用到的地方各自复制一份同样的样式。
                 HomePage.xaml 里原来的同名局部资源已删除，改成引用这里。 -->
            <!-- 键盘导航使用单层描边，避免叠加阴影；鼠标点击不会额外出现焦点框。 -->
            <Style x:Key="KeyboardFocusRing" TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Control">
                            <Rectangle Margin="-2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                       StrokeDashArray="2,1" RadiusX="4" RadiusY="4" IsHitTestVisible="False"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GuestModeToggleStyle" TargetType="ToggleButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 全局窗口图标：不需要挨个给 20 多个弹窗窗口（AccountPickerWindow、
                 CreateServerWindow 等）单独写 Icon="..."，用不带 x:Key 的隐式 Style
                 让所有未显式设置 Icon 的 Window 都自动套用同一个应用图标，
                 任务栏/Alt-Tab/标题栏左上角统一显示，而不是系统默认的白纸图标。
                 MainWindow.xaml 已经显式设置了同一个 Icon，不受影响。 -->
            
            <Style TargetType="Window"/>

            <Style TargetType="ToolTip">
                <Setter Property="services:PageTransitionBehavior.PopupFadeOnVisible" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <!-- 显式关掉系统主题外观：不这样设的话，即使下面自定义了 Template，
                     部分 Windows 版本仍然会在 Popup 外层套一层系统 uxtheme 边框/背景，
                     跟自定义模板的圆角描边叠在一起显得双重描边。 -->
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    MaxWidth="360">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
                                </Border.Effect>
                                <Border.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </Border.Resources>
                                <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"
                                                   TextBlock.FontSize="{TemplateBinding FontSize}"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            
            <Geometry x:Key="IconHome">M12 3 L21 10.5 V21 H14 V15 H10 V21 H3 V10.5 Z</Geometry>
            <Geometry x:Key="IconFolder">M3 6 H10 L12 8.5 H21 V19 H3 Z</Geometry>
            <Geometry x:Key="IconDownload">M12 3 V14 M12 14 L7.5 9.5 M12 14 L16.5 9.5 M4 17 V20 H20 V17</Geometry>
            <Geometry x:Key="IconGlobe">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M3 12 H21 M12 3 A13 13 0 0 1 12 21 M12 3 A13 13 0 0 0 12 21</Geometry>
            <Geometry x:Key="IconPuzzle">M9 4 H15 V7 A2 2 0 0 0 19 7 V13 H16 A2 2 0 0 0 16 17 H19 V20 H5 V7 H8 A2 2 0 0 0 9 4 Z</Geometry>
            <Geometry x:Key="IconServer">M3 5 H21 V11 H3 Z M3 13 H21 V19 H3 Z M6.5 8 H7 M6.5 16 H7</Geometry>
            <Geometry x:Key="IconToolbox">M3 9 H21 V20 H3 Z M9 9 V6 H15 V9 M3 14 H21</Geometry>
            <!-- 基岩版启动导航图标：简化的方块/砖块堆叠图案，呼应"基岩版"的方块主题，
                 跟其它导航图标一样是单色线框风格（NavIconPath 统一描边，不填色）。 -->
            <Geometry x:Key="IconBedrock">M3 4 H11 V10 H3 Z M13 4 H21 V10 H13 Z M3 12 H11 V18 H3 Z M13 12 H21 V18 H13 Z</Geometry>
            <Geometry x:Key="IconAccount">M12 4 A4 4 0 1 1 12 12 A4 4 0 1 1 12 4 M4.5 21 A7.5 7.5 0 0 1 19.5 21</Geometry>
            <Geometry x:Key="IconSettings">M12 8.5 A3.5 3.5 0 1 1 12 15.5 A3.5 3.5 0 1 1 12 8.5 M12 2.5 V5 M12 19 V21.5 M21.5 12 H19 M5 12 H2.5 M18.7 5.3 L17 7 M7 17 L5.3 18.7 M18.7 18.7 L17 17 M7 7 L5.3 5.3</Geometry>
            <Geometry x:Key="IconLogs">M6 3 H16 L19 6 V21 H6 Z M9 8 H16 M9 12 H16 M9 16 H13</Geometry>
            <Geometry x:Key="IconFlask">M10 3 V9 L5 19 A1.5 1.5 0 0 0 6.5 21 H17.5 A1.5 1.5 0 0 0 19 19 L14 9 V3 M9 3 H15 M7.5 15 H16.5</Geometry>
            <Geometry x:Key="IconMenu">M4 7 H20 M4 12 H20 M4 17 H20</Geometry>
            <!-- 侧边栏「更多」导航按钮用：三个横向圆点，跟系统里常见的"更多"图标含义一致，
                 跟其它导航图标（多为线框轮廓）区分开，一眼能认出这不是某个具体功能而是入口集合。 -->
            <Geometry x:Key="IconMore">M5 12 A1.6 1.6 0 1 1 5 12.01 M12 12 A1.6 1.6 0 1 1 12 12.01 M19 12 A1.6 1.6 0 1 1 19 12.01</Geometry>
            <!-- 自绘标题栏的最小化/最大化/还原/关闭四个按钮图标，风格跟导航图标一致
                 （单色线框、24×24 viewBox），见 MainWindow.xaml 顶部自绘标题栏说明。 -->
            <Geometry x:Key="IconWinMinimize">M5 12 H19</Geometry>
            <Geometry x:Key="IconWinMaximize">M6 6 H18 V18 H6 Z</Geometry>
            <Geometry x:Key="IconWinRestore">M9 9 H18 V18 H9 Z M6 6 H15 V9 M6 6 V15 H9</Geometry>
            <Geometry x:Key="IconWinClose">M6 6 L18 18 M18 6 L6 18</Geometry>
            <!-- 「鸣谢与帮助」导航图标：一个简化的心形，呼应"鸣谢/感谢"的语义，
                 同时跟其它导航图标一样是单色线条风格，不引入实心填充打破视觉统一。 -->
            <Geometry x:Key="IconHeart">M12 20 C12 20 4 14.5 4 9 A4 4 0 0 1 12 6.5 A4 4 0 0 1 20 9 C20 14.5 12 20 12 20 Z</Geometry>
            <Geometry x:Key="IconDot">M12 8.5 A3.5 3.5 0 1 1 12 15.5 A3.5 3.5 0 1 1 12 8.5 Z</Geometry>
            <Geometry x:Key="IconAI">M12 2.8 L13.35 7.05 L17.6 8.4 L13.35 9.75 L12 14 L10.65 9.75 L6.4 8.4 L10.65 7.05 Z M18.2 13.2 L18.95 15.45 L21.2 16.2 L18.95 16.95 L18.2 19.2 L17.45 16.95 L15.2 16.2 L17.45 15.45 Z M5.2 14.4 L5.75 16.05 L7.4 16.6 L5.75 17.15 L5.2 18.8 L4.65 17.15 L3 16.6 L4.65 16.05 Z</Geometry>
            <!-- AI 助手工具栏图标。AiAssistantPanel 会在应用资源初始化阶段通过 StaticResource 解析，
                 所以这些 Geometry 必须定义在 App.xaml 中；缺任意一个都会让整个主窗口在 XAML Parse 阶段直接启动失败。 -->
            <Geometry x:Key="IconHistory">M5 6 H15 A6 6 0 1 1 6.5 18 M5 6 V11 M5 6 H10 M15 9 V13 L18 15</Geometry>
            <Geometry x:Key="IconPlus">M12 5 V19 M5 12 H19</Geometry>
            <Geometry x:Key="IconClose">M6 6 L18 18 M18 6 L6 18</Geometry>
            <Geometry x:Key="IconSend">M3 4 L21 12 L3 20 L7 12 Z M7 12 H15</Geometry>

            <!-- 导航图标统一样式：**尺寸写死在这里**，是上面两个 bug 不再复发的关键。
                 Width/Height 固定 20，Stretch=Uniform 让 24 的 viewBox 等比缩到 20；
                 UseLayoutRounding 保证描边落在整像素上、不同缩放比下不发虚。 -->
            <Style TargetType="Path" x:Key="NavIconPath">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="StrokeThickness" Value="1.6"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="Fill" Value="Transparent"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <!-- 图标外层固定尺寸盒子：即使以后有人换了别的图标/字体，
                 该盒子也保证每一行图标占位完全一致，不会再出现"某一个小一像素"。 -->
            <Style TargetType="Border" x:Key="NavIconBox">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            
            <Style TargetType="Button" x:Key="CaptionButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <!-- 46×32 是 Windows 10/11 原生标题栏按钮在 100% 缩放下的实际尺寸
                     （之前写的 44×36 是凭感觉估的，跟系统按钮站一起明显偏大/偏方，
                     这就是"标题栏跟系统的不一样"的直接原因之一）。 -->
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" x:Key="CaptionCloseButton" BasedOn="{StaticResource CaptionButton}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 关闭按钮悬停时图标改白色（红底配深色线框看不清），其余两个按钮悬停时
                 沿用 TextPrimaryBrush 即可，不需要单独处理。 -->
            <Style TargetType="Path" x:Key="CaptionIconPath" BasedOn="{StaticResource NavIconPath}">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="10"/>
                <!-- 系统标题栏的最小化/最大化/关闭图标描边是 1px 极细线，
                     沿用导航图标的 1.6 描边会显得比系统的粗、发"肿"，这里单独调细。 -->
                <Setter Property="StrokeThickness" Value="1"/>
            </Style>
            <Style TargetType="Path" x:Key="CaptionCloseIconPath" BasedOn="{StaticResource CaptionIconPath}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="Stroke" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 旧版预览圆形标题栏资源保留兼容。完整新界面预览由 PreviewFluentTheme
                 替换标题栏与页面资源；退出时恢复本字典的原样式。
                 平时完全透明看不出轮廓，只有悬停/按下时整块填充成一个实心圆，关闭按钮
                 悬停变红——这才是 PCL 标题栏按钮的观感，而不是常驻画一圈描边空心圆。 -->
            <Style TargetType="Button" x:Key="PreviewRoundCaptionButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="3,1"/>
                <Setter Property="Cursor" Value="Arrow"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- 宽高必须相等（30×30）+ CornerRadius 恰好等于半径(15)才是正圆，
                                 不是随手写个大数字就行。 -->
                            <Border x:Name="bd" CornerRadius="15" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Button" x:Key="PreviewRoundCaptionCloseButton" BasedOn="{StaticResource PreviewRoundCaptionButton}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="15" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
            <Style TargetType="UserControl">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <!-- Shared action surfaces preserve routed commands, complete content templates,
                 alignment and keyboard access. Only decorative focus visuals ignore hit testing. -->
            <Style TargetType="Button" x:Key="ActionButtonBase">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Padding" Value="11,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ActionSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                    </MultiTrigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsDefaulted" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.48"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource ActionButtonBase}"/>
            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ActionButtonBase}">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="MinHeight" Value="34"/>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ActionButtonBase}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="13,7"/>
                <Setter Property="MinHeight" Value="34"/>
            </Style>
            <Style TargetType="Button" x:Key="CompactActionButton" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="11,5"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style TargetType="Button" x:Key="QuietActionButton" BasedOn="{StaticResource CompactActionButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!-- 右下角悬浮球按钮：圆形、带阴影/发光效果，用于 AI 助手入口 -->
            <Style TargetType="Button" x:Key="FloatingButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="22"
                                    Effect="{StaticResource GlowEffect}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                    <Setter TargetName="bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#00C2E8" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 图标按钮样式：用于 AI 面板顶部工具栏按钮 -->
            <Style TargetType="Button" x:Key="IconButtonStyle">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            
            <Style TargetType="Button" x:Key="VersionChipButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            
            <Style TargetType="RadioButton" x:Key="GameVersionTabRadioButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" x:Key="SideNavButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                    BorderThickness="2,0,0,0" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
                                </Trigger>
                                <!-- 基本模式（RestrictedMode）门控靠 IsEnabled=false 置灰受限的导航按钮，
                                     但该模板原来没有对应的视觉反馈——IsEnabled=false 只是让按钮吃不到点击，
                                     图标/文字看起来还是正常颜色，用户分不清"该功能存在但用不了"和
                                     "该功能能点"。补一个禁用态：整体降低不透明度 + 鼠标显示"禁止"光标，
                                     跟其它控件（比如 TextBox）的禁用态处理方式保持一致。 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 搜索/筛选输入框：圆角卡片风格，与整体白底蓝色主题保持一致（原先用系统默认方框样式，视觉割裂）。
                 焦点态用主色描边，给"正在输入会触发自动刷新"一个轻微的视觉反馈。 -->
            
            <Style TargetType="TextBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource GlowSoftBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox" x:Key="SearchTextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>

            <!-- PasswordBox：跟 TextBox 走同一套外观逻辑（系统默认同样是白底方角），
                 项目里唯一一处密码框(认证服务器登录)不应该是唯一一个还留着系统默认样式的
                 输入控件。ControlTemplate 结构跟 TextBox 完全一致，只是 PART_ContentHost
                 是 PasswordBox 专属的模板部件名。 -->
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource GlowSoftBrush}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="toggle" Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False" ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="▾" FontSize="10" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="content" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                   ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260"
                                            services:PageTransitionBehavior.PopupFadeOnVisible="True">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="toggle" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="toggle" Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 兼容旧代码：部分 XAML 显式写了 Style="{StaticResource FilterComboBox}"，
                 保留该 key 名并直接复用上面的默认样式，避免逐个改动引用处。 -->
            <Style TargetType="ComboBox" x:Key="FilterComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>

            
            <Style TargetType="ComboBox" x:Key="TallPopupComboBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="toggle" Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False" ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="▾" FontSize="10" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="content" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                   ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                <!-- 同上面默认 ComboBox 样式：该 Popup 必须叫 "PART_Popup"，
                                     ComboBox 才能在 OnApplyTemplate 里找到它并挂上 DropDownClosed 等事件。 -->
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                    <!-- 关键改动：MaxHeight 从固定的 260 换成屏幕高度的 0.55 倍，
                                         其余（背景/圆角/滚动条）跟默认 ComboBox 模板保持一致。 -->
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}, Converter={StaticResource ScreenHeightFractionConverter}, ConverterParameter=0.55}"
                                            services:PageTransitionBehavior.PopupFadeOnVisible="True">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="toggle" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="toggle" Property="BorderBrush" Value="{DynamicResource GlowBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 下拉框展开后每一项的外观：默认系统样式选中态是刺眼的蓝色系统高亮条，
                 这里统一换成跟其它控件一致的浅蓝高亮 + 圆角，避免打开下拉框那一下突然
                 冒出一块跟整体风格不搭的系统原生蓝条。 -->
            <!-- PCL 风格隐形滚动条：默认几乎不可见（细窄轨道、透明拇指），只有鼠标悬停在
                 滚动条区域时拇指才淡入变得清晰可见、可拖动。避免像系统默认滚动条那样常驻
                 一条灰色宽轨道，视觉上更干净，也是 PCL/HMCL 这类启动器的通用做法。
                 拇指(Thumb)颜色用 TextSecondaryBrush：在深色/浅色任意皮肤下都有基本可辨识度，
                 平时(未悬停)完全透明不占视觉空间，悬停时才淡入到半透明可见。 -->
            <Style x:Key="HiddenScrollBarPageButton" TargetType="RepeatButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="0"/>
                                </Grid.RowDefinitions>
                                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource HiddenScrollBarPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource HiddenScrollBarPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="PART_Thumb" Width="6" Opacity="0">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource TextSecondaryBrush}" CornerRadius="3"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 鼠标悬停在滚动条整个区域(包括轨道空白处，不需要精确点在窄窄的
                                     拇指上)时，拇指从完全透明淡入到半透明可见，拖动区域同时略微
                                     变宽，方便精确拖拽；离开后自动淡回透明，符合 PCL 那种
                                     "划到边上才有反馈、平时几乎看不见"的手感。 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_Thumb" Property="Opacity" Value="0.6"/>
                                    <Setter TargetName="PART_Thumb" Property="Width" Value="8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 全局 ListBox 外观：默认系统样式会带一圈刺眼的白色/系统主题描边和方角，
                 这里统一换成跟其它输入控件一致的圆角卡片风格，滚动条替换成上面定义的
                 隐形滚动条(ScrollViewer 内嵌 PART_ScrollBar 会自动套用上面 ScrollBar 的全局样式，
                 不需要在这里重复写)。不加 x:Key，作为全应用默认样式自动套用到所有 ListBox。 -->
            <Style TargetType="ListBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 全局 ListBoxItem：去掉系统默认的蓝色选中框/虚线焦点框，改成跟 ComboBoxItem
                 一致的圆角高亮，未选中时完全透明、hover 时浅色底、选中时主色调底+强调色文字。
                 不加 x:Key，自动套用到所有未显式指定 Style/ItemContainerStyle 的 ListBox 条目
                 （DownloadListItem 等显式 x:Key 引用的地方不受影响）。 -->
            <Style TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" TextBlock.Foreground="{TemplateBinding Foreground}"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="selectionCheck" Grid.Column="1" Width="12" Height="10" Margin="14,0,0,0"
                                          VerticalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False"
                                          Data="M 1,5 L 4.5,8.5 L 11,1" Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="selectionCheck" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <!-- "开发中"的锁定项（比如蓝色/黄色配色皮肤）IsEnabled=False，
                                     用半透明+次要文字色显示为灰置状态，让用户一眼看出这项现在点不了，
                                     而不是误以为下拉框卡住了或者是 bug。 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 下载中心列表项外层卡片（重做版 UI）：每一项都是一张独立的圆角卡片，跟 SideBrush
                 底色区分开、卡片之间留白，而不是旧版那种"贴着边框的一行文字"。hover 时卡片
                 边框转强调色 + 轻微上浮阴影，明确"这是一个可点击的条目"；选中态（游戏版本列表用
                 SelectionMode）额外叠一层柔光底色。 -->
            <Style TargetType="ListBoxItem" x:Key="DownloadListItem">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="{DynamicResource SideBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrush2}" CornerRadius="10" Padding="12,10">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="14"
                                                               ShadowDepth="2" Direction="270"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 重做版 UI 新增：资源来源徽标（Modrinth/CurseForge），取代旧版直接在标题后面拼
                 "  [Modrinth]" 纯文字的做法——纯文字混排在粗体标题里既不美观，字号/间距也很难看清，
                 现在做成一个独立的小圆角色块徽标，靠 Tag 判断来源自动上色（Modrinth 绿色调、
                 CurseForge 橙色调，其余来源用中性强调色）。 -->
            <Style TargetType="Border" x:Key="SourceBadge">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
            </Style>

            <!-- 全局 CheckBox / RadioButton 样式：之前只有 ComboBox 套了科技感圆角风格，
                 CheckBox/RadioButton 在各个页面（SettingsPage、ServerPropertiesWindow、
                 SkinSelectWindow 等）还是系统默认的方框/圆点勾选框，跟其它控件视觉割裂。
                 这里不加 x:Key，作为全应用默认样式，自动套用到所有未显式设置 Style 的
                 CheckBox / RadioButton 上，配色跟 ComboBox/PrimaryButton 保持一致：
                 未选中=浅色描边，hover=浅蓝底+蓝描边，选中=主色描边+青色对勾/圆点+发光。
                 注意：DownloadCategoryButton 是显式 x:Key 引用，不受该隐式默认样式影响。 -->
            <!-- 全局 ProgressBar：系统默认是一条绿色渐变进度条 + 灰色轨道，跟整体配色完全
                 不搭（尤其在深色皮肤下，灰色轨道在深色背景上显得像一块"没渲染出来的白块"）。
                 这里统一改成扁平的圆角胶囊样式：轨道用 SideBrush，进度用 AccentBrush，
                 跟按钮/强调色保持一致。不确定态(IsIndeterminate)保留系统默认动画行为，
                 只换配色，不重写动画模板。 -->
            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="TrackBg" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"/>
                                <Border x:Name="PART_Track" Margin="{TemplateBinding BorderThickness}" Background="Transparent" ClipToBounds="True">
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                            HorizontalAlignment="Left" CornerRadius="6"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 全局 TabControl / TabItem：系统默认标签页是灰白背景 + 立体边框，同样跟
                 整体扁平化配色不搭。TabItem 未选中态用次要文字色+透明背景，选中态用
                 强调色文字+底部一条高亮线，内容区背景用 PanelBrush，跟其它卡片容器统一。 -->
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <!-- 固定用 SemiBold（不再随选中状态切换字重）：字重变化会改变文字测量宽度，
                     TabPanel 是按行自动换行摆放的，一旦某一项选中后变宽/变窄，会导致换行结果
                     整体重新计算，后面所有条目跟着挪位置、页面看起来在"跳动"。字重固定后，
                     每一项的宽度不会再因选中/取消选中而改变，条目位置就不会再跟着挑动了。 -->
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="services:PageTransitionBehavior.AnimateSelection" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}">
                                    <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
                                </Border>
                                <Border Grid.Row="1" Background="{DynamicResource PanelBrush}">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,10,0,0"/>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="box" Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1.5" VerticalAlignment="Center">
                                    <Path x:Name="check" Data="M 2,8 L 6,12 L 14,3" Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Opacity="0" Stretch="Uniform" Margin="2"/>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Margin="8,0,0,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="check" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="{x:Null}">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource BorderBrush2}"/>
                                    <Setter TargetName="check" Property="Opacity" Value="1"/>
                                    <Setter TargetName="check" Property="Data" Value="M 3,7 L 15,7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 表格也使用全局动态画刷，避免深色界面中出现系统白底。
                 保留 DataGrid 的默认编辑、校验、滚动和虚拟化实现，只替换视觉样式。 -->
            <Style x:Key="ThemedDataGridText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}}}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="ThemedDataGridEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="Padding" Value="3,2"/>
                <Setter Property="MinHeight" Value="24"/>
            </Style>
            <Style x:Key="ThemedDataGridCheckEditor" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
            </Style>
            <Style x:Key="ThemedDataGridCheck" TargetType="CheckBox" BasedOn="{StaticResource ThemedDataGridCheckEditor}">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                        <Path x:Name="SortGlyph" Grid.Column="1" Width="8" Height="5" Margin="8,0,0,0"
                                              Fill="{DynamicResource TextPrimaryBrush}" Data="M 0,5 L 4,0 L 8,5 Z"
                                              Stretch="Fill" VerticalAlignment="Center" Visibility="Collapsed"
                                              RenderTransformOrigin="0.5,0.5"/>
                                    </Grid>
                                </Border>
                                <Thumb x:Name="PART_LeftHeaderGripper" Width="5" HorizontalAlignment="Left" Cursor="SizeWE">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
                                </Thumb>
                                <Thumb x:Name="PART_RightHeaderGripper" Width="5" HorizontalAlignment="Right" Cursor="SizeWE">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="SortGlyph" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="MinHeight" Value="32"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SoftHeaderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource SoftHeaderForegroundBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SoftHeaderBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource SoftHeaderForegroundBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource SideBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="EnableRowVirtualization" Value="True"/>
                <Setter Property="EnableColumnVirtualization" Value="True"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="services:DrawerMotionBehavior.Enabled" Value="True"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton x:Name="HeaderToggle" Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="10,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path x:Name="arrow" Grid.Column="0" Data="M 0,0 L 8,0 L 4,6 Z"
                                                          Fill="{DynamicResource TextSecondaryBrush}" Width="8" Height="6"
                                                          Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <ContentPresenter Grid.Column="1" ContentSource="Content"
                                                                       TextBlock.Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header" TextBlock.Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="circle" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                        BorderThickness="1.5" VerticalAlignment="Center">
                                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Opacity="0"/>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Margin="8,0,0,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="circle" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="circle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="circle" Property="Effect" Value="{StaticResource GlowEffect}"/>
                                    <Setter TargetName="dot" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            
            <Style TargetType="RadioButton" x:Key="DownloadCategoryButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                    BorderThickness="0" Padding="{TemplateBinding Padding}">
                                <!-- TextElement.Foreground 附加属性把 RadioButton.Foreground 强制"传"给内部
                                     TextBlock：全局隐式 TextBlock 样式（见上面 TargetType="TextBlock"）显式设置了
                                     Foreground=TextPrimaryBrush，该显式 Setter 的优先级高于属性继承，普通继承
                                     不会生效，必须用 TextElement.Foreground 该附加属性从外层强制下发才能盖过它。 -->
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- GridViewColumnHeader：ListView + GridView（比如"注入检测"页的模块列表）
                 表头默认是一排系统灰色 3D 立体按钮，跟应用整体扁平化风格格格不入，也是
                 反馈里"部分白色/灰色突兀区域"的来源之一。改成扁平底色 + 底部分隔线，
                 hover 时轻微高亮，不再有系统按钮的立体边框和渐变。 -->
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border x:Name="bd" Background="{DynamicResource SideBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 修复"更多"菜单(如服务器卡片右上角 ... 按钮弹出的 ContextMenu)在深色/非白色皮肤下
                 看不清的问题：WPF 的 ContextMenu/MenuItem 在没有显式样式时会回退到系统默认外观
                 (白底黑字)，而这批菜单是在 code-behind 里用 `new ContextMenu`/`new MenuItem` 纯代码
                 构造的(见 ServerManagerPage.ShowInstanceMoreMenu 等)，之前完全没有套用任何应用内样式，
                 只在白色系皮肤下碰巧能看清，切到其它色系/深色模式后菜单背景仍是系统白、跟周围深色
                 界面格格不入，文字也可能因为都是深色而看不清。这里统一用 DynamicResource 绑定当前
                 皮肤的 PanelBrush/TextPrimaryBrush/BorderBrush2/GlowSoftBrush，跟随 ThemeService
                 切换皮肤时自动刷新，不需要 code-behind 那边做任何改动——纯代码 new 出来的
                 ContextMenu/MenuItem 只要没有显式设置 Style，就会自动应用这里的隐式类型样式。 -->
            <!-- 右键菜单（含 TextBox/RichTextBox/PasswordBox 编辑文字时系统自动弹出的
                 "剪切/复制/粘贴"菜单——这些也是普通 ContextMenu+MenuItem，同样吃这份隐式样式）：
                 之前的版本只转发了 Header，没处理 Icon 和 InputGestureText（Ctrl+X 这类快捷键提示），
                 WPF 会在没有对应视觉呈现的情况下退化成很难看的默认灰底样式，跟其它自绘控件的
                 圆角卡片风格格格不入。这里统一用 Grid 分栏（图标 / 文字 / 快捷键 / 子菜单箭头），
                 圆角、间距、配色都跟应用其它弹层（下拉框、Popup 卡片）保持一致，且完全走
                 DynamicResource，跟随 ThemeService 切皮肤自动刷新。 -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                    Padding="{TemplateBinding Padding}" MinWidth="132" services:PageTransitionBehavior.PopupFadeOnVisible="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.28" BlurRadius="18" ShadowDepth="3" Direction="270"/>
                                </Border.Effect>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="checkedGlyph" Grid.Column="0" Width="13" Height="11" Margin="0,0,8,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"
                                          Data="M 1,5 L 4.5,9 L 12,1" Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <ContentPresenter x:Name="iconPresenter" Grid.Column="0" ContentSource="Icon"
                                                       Width="15" Height="15" Margin="0,0,8,0"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       TextBlock.Foreground="{TemplateBinding Foreground}"
                                                       TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock x:Name="gestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                               Margin="22,0,0,0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"/>
                                    <Path x:Name="arrow" Grid.Column="3" Width="6" Height="9" Margin="12,0,0,0"
                                          VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed"
                                          Data="M0,0 L1,0.5 L0,1" Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Border>
                                <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                            BorderThickness="1" CornerRadius="10" Padding="5" MinWidth="150"
                                            services:PageTransitionBehavior.PopupFadeOnVisible="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 只有真正带了 Icon 内容的菜单项才腾出图标列，普通的
                                     "剪切/复制/粘贴"没有图标时，不留一块空白挤占文字。 -->
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsCheckable" Value="True">
                                    <Setter TargetName="checkedGlyph" Property="Visibility" Value="Hidden"/>
                                    <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="checkedGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                </Trigger>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ContextMenu 里的 Separator：默认系统样式是一条几乎看不见的浅灰细线(在深色皮肤下
                 更是完全隐形)，改成跟随皮肤的 DividerBrush，两端留出跟 MenuItem 对齐的内边距，
                 保证分组间隔在任何色系下都清晰可辨、观感上也不再是硬邦邦贴边的一条线。 -->
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- [已废弃，仅作参照，无任何引用] 资源面板(材质包/数据包/光影包/服务端插件等)版本：
                 比 Mod 那份多一个"数据包安装到哪个存档"的下拉框，其余结构一致。已被
                 ServerManagerPage 的"整页跳转详情"(ModDetailPage，见 OpenServerResourceDetailAsync)
                 取代，服务端插件/资源包面板不再使用这份卡片内联展开模板，跟客户端
                 InlineVersionExpandPanel_Mod 被 ModDetailPage 取代是同一次改动。保留只作参照。 -->
            <DataTemplate x:Key="InlineVersionExpandPanel_Resource" DataType="{x:Type models:UnifiedResourceItem}">
                <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource SideBrush}" CornerRadius="6" Margin="0,6,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Ui_Loading_Versions}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding IsLoadingVersions, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Visibility="{Binding IsDataPack, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Str_Ui_Install_Into_Which_World}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SaveNames}" SelectedItem="{Binding SelectedSaveName, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str_Ui_No_Matching_Versions_Found_The_Game_Vers}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:InlineVersionEntry}">
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Margin="0,3" Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding VersionNumber, Mode=OneWay}"/>
                                                    <Run Text="{DynamicResource Str_Ui_Supports}"/><Run Text="{Binding GameVersionsText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{DynamicResource Str_Common_Download}" Style="{StaticResource PrimaryButton}"
                                                    Padding="10,5" FontSize="13" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- 现代圆角滑块样式：细长圆角轨道 + 已划过部分用 AccentBrush 填充、
                 未划过部分用浅灰填充、圆形滑块带白色描边和轻微阴影（对齐"图2"效果），
                 替换 WPF 默认 Slider 那种带刻度凹槽的老式外观。全局隐式样式，
                 SettingsPage 里所有 <Slider> 不用改代码自动生效。 -->
            <Style x:Key="ModernSliderThumb" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid>
                                <Ellipse x:Name="ThumbShadow" Width="20" Height="20" Fill="#22000000" Margin="0,2,0,0"/>
                                <Ellipse x:Name="ThumbEllipse" Width="18" Height="18" Fill="{DynamicResource AccentBrush}"
                                         Stroke="White" StrokeThickness="2"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbEllipse" Property="Width" Value="20"/>
                                    <Setter TargetName="ThumbEllipse" Property="Height" Value="20"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbEllipse" Property="Width" Value="22"/>
                                    <Setter TargetName="ThumbEllipse" Property="Height" Value="22"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Slider">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border x:Name="TrackBackground" Height="4" CornerRadius="2"
                                        Background="#E1E5EA" VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" CornerRadius="2" Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernSliderThumb}" Width="22" Height="22"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
