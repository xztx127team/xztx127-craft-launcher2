<UserControl x:Class="XCL2.App.Views.DriverDownloadLinks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,8,0,12">
            <StackPanel>
                <TextBlock Text="下载 / 更新 OpenGL 显卡驱动" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="OpenGL 由显卡驱动提供。安装与你的显卡及 Windows 匹配的最新驱动，即可获得硬件支持的 OpenGL 版本。"
                           TextWrapping="Wrap" Margin="0,6,0,10"/>
                <TextBlock Text="选择下方厂商官网查看适配驱动，也可以复制官网的安装包直链，在启动器中下载。"
                           TextWrapping="Wrap" FontSize="11" Opacity="0.75" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Text="从显卡厂商官网下载最新版" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <WrapPanel>
            <StackPanel Margin="0,0,8,8">
                <Button Content="NVIDIA 官方驱动" Tag="https://www.nvidia.com/en-us/drivers/" Click="OpenLink_Click" Padding="10,6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <Button Content="AMD 官方驱动" Tag="https://www.amd.com/en/support/download/drivers.html" Click="OpenLink_Click" Padding="10,6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <Button Content="Intel 官方驱动" Tag="https://www.intel.com/content/www/us/en/download-center/home.html" Click="OpenLink_Click" Padding="10,6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <Button Content="Intel 自动检测与更新" Tag="https://www.intel.com/content/www/us/en/support/detect.html" Click="OpenLink_Click" Padding="10,6"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,8">
                <Button Content="OpenGL 官方说明 ↗" Tag="https://wikis.khronos.org/opengl/Getting_Started" Click="OpenLink_Click" Padding="10,6"/>
            </StackPanel>
        </WrapPanel>
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="在启动器内下载驱动安装包" FontWeight="SemiBold"/>
                <TextBox x:Name="DriverPackageUrl" ToolTip="粘贴显卡厂商提供的 https 安装包直链" Margin="0,8,0,8"/>
                <Button Content="下载安装包…" Click="DownloadPackage_Click" HorizontalAlignment="Left" Padding="12,8" Style="{DynamicResource PrimaryButton}"/>
                <TextBlock x:Name="DriverDownloadStatus" Text="下载完成后可在保存目录查看安装包，按厂商说明安装。" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <Expander Header="镜像下载站 / 自定义链接" Margin="0,0,0,8">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="第三方镜像：请在页面中选择与你的显卡、Windows 版本匹配的驱动，并核对安装包发布者。" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,8,8">
                        <Button Content="NVIDIA · TechPowerUp 镜像" Tag="https://www.techpowerup.com/download/nvidia-geforce-graphics-drivers/" Click="OpenLink_Click" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <Button Content="AMD · Guru3D 镜像" Tag="https://www.guru3d.com/files/category/videocards-ati-catalyst-windows-7-8-10" Click="OpenLink_Click" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,8">
                        <Button Content="TechPowerUp 驱动下载站" Tag="https://www.techpowerup.com/download/" Click="OpenLink_Click" Padding="10,6"/>
                    </StackPanel>
                </WrapPanel>
                <TextBox x:Name="CustomUrl" ToolTip="输入其它厂商或镜像站的 https 地址" Margin="0,2,0,4"/>
                <Button Content="一键打开自定义链接 ↗" Click="OpenCustom_Click" HorizontalAlignment="Left" Padding="10,6"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
