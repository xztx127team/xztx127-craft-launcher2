<local:OverlayDialogControl x:Class="XCL2.App.Views.SelectJavaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="440">
    
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource Str_Ui_Pick_A_Java_Runtime_From_Your_Java_List}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <ListBox x:Name="JavaListBox" Height="140" DisplayMemberPath="DisplayText"/>
        <TextBlock Text="{DynamicResource Str_Ui_Not_Seeing_The_One_You_Want_Add_It_To_Th}" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="{DynamicResource Str_Common_Ok}" Width="80" Style="{DynamicResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</local:OverlayDialogControl>
