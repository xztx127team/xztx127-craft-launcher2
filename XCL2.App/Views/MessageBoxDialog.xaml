<local:OverlayDialogControl x:Class="XCL2.App.Views.MessageBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        MinWidth="360" MaxWidth="520">
    
    <StackPanel Margin="24" MaxWidth="480">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock x:Name="IconText" FontSize="26" FontFamily="Segoe UI Emoji" VerticalAlignment="Top" Margin="0,0,12,0"/>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
        </ScrollViewer>

        <TextBlock x:Name="ErrorCodeText" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
        <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </StackPanel>
</local:OverlayDialogControl>
