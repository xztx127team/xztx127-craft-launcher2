<local:OverlayDialogControl x:Class="XCL2.App.Views.LanguageSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="420">
    
    <DockPanel Margin="0">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_Lang_DialogTitle}"
                   FontSize="18" FontWeight="Bold" Margin="20,20,20,4"/>

        <!-- 实验性功能提示条：常驻显示在列表上方，不管当前选的是不是简体中文都显示，
             提前告知用户"切走了会看到实验性功能消失"，避免用户切换语言后找不到入口
             以为是 bug。 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource WarningBannerBrush}" CornerRadius="6"
                Margin="20,8,20,12" Padding="10,8">
            <TextBlock Text="{DynamicResource Str_Lang_ExperimentalNotice}"
                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}"/>
        </Border>

        <Button DockPanel.Dock="Bottom" x:Name="CancelBtn" Content="{DynamicResource Str_Lang_Cancel}"
                HorizontalAlignment="Right" Margin="0,0,20,20" Padding="16,8" Click="Cancel_Click"/>

        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0">
            <ItemsControl x:Name="LanguageList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="LanguageItem_Click" Tag="{Binding Code}"
                                HorizontalContentAlignment="Stretch" Padding="4,12" Margin="0,0,0,2"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding NativeName}" FontSize="15"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="&#10003;" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding IsCurrentVisibility}"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</local:OverlayDialogControl>
