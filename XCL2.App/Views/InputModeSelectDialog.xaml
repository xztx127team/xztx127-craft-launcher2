<local:OverlayDialogControl x:Class="XCL2.App.Views.InputModeSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="440">
    
    <StackPanel Margin="20">
        <TextBlock Text="本次启动使用哪种操作方式？" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="触屏模式会在游戏画面上叠加一层虚拟按键（方向、跳跃、潜行、丢弃、ESC/F3/DEL 等），适合在平板上不接键鼠直接玩。"/>

        <Button x:Name="KeyboardBtn" HorizontalAlignment="Stretch" Padding="14,10" Margin="0,0,0,8"
                HorizontalContentAlignment="Left" Click="Keyboard_Click">
            <StackPanel>
                <TextBlock Text="键鼠模式（默认）" FontWeight="SemiBold"/>
                <TextBlock Text="不加任何覆盖层，跟平时一样用键盘和鼠标。" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Button>

        <Button x:Name="TouchBtn" HorizontalAlignment="Stretch" Padding="14,10" Margin="0,0,0,4"
                HorizontalContentAlignment="Left" Click="Touch_Click">
            <StackPanel>
                <TextBlock Text="触屏模式" FontWeight="SemiBold"/>
                <TextBlock Text="加载虚拟按键悬浮层，适合微软平板等触摸设备。" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Button>
        <!-- 实验性功能提示：直接写在按钮下面（内嵌，不再单独弹一个确认框打断该选择流程），
             每次弹该"这次用键鼠还是触屏"的框都能看到，不需要用户记住"设置里勾选时提醒过一次"。
             用 WarningTextBrush，跟项目里其它警告文案统一配色。 -->
        <TextBlock Text="⚠ 触屏模式目前是实验性功能，依赖底层鼠标钩子模拟输入，可能出现视角异常、按键无响应等问题，仍在完善中。"
                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource WarningTextBrush}"/>

        <CheckBox x:Name="RememberCheck" Margin="0,0,0,10"
                  Content="记住这次选择，以后不再询问（可在设置里改回来）"/>

        <!-- 倒计时提示：明确告诉用户"不选会发生什么、还剩多久"，
             避免弹窗自己消失时用户以为启动器出了问题。 -->
        <TextBlock x:Name="CountdownText" FontSize="11" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</local:OverlayDialogControl>
