<UserControl x:Class="XCL2.App.Views.ModManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:XCL2.App.Services">
    <UserControl.Resources><services:InstancePickerLabelConverter x:Key="InstanceFolderLabel"/></UserControl.Resources>
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Str_Nav_ModManager}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="兼容性预览" Style="{StaticResource SideNavButton}" Margin="0,0,8,0" Click="PreviewCompatibility_Click"/>
                    <Button Content="更多" Style="{StaticResource SideNavButton}" Margin="0,0,8,0" Click="MoreActions_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="检查模组更新" Click="BatchUpdateMods_Click"/>
                                <MenuItem Header="查看上次检查资料" Click="ShowCachedModMetadata_Click"/>
                                <MenuItem Header="已忽略的更新版本" Click="ManageIgnoredModUpdates_Click"/>
                                <Separator/>
                                <MenuItem Header="筛选与批量启停" Click="ToggleModFilter_Click"/>
                                <Separator/>
                                <MenuItem Header="导出整合包" Click="ExportModpack_Click"/>
                                <MenuItem Header="导入整合包" Click="ImportModpack_Click"/>
                                <Separator/>
                                <MenuItem Header="检查缺失前置模组" Click="AnalyzeDependencies_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="{DynamicResource Str_Common_Refresh}" Style="{StaticResource PrimaryButton}" Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FolderCombo" Grid.Column="0" Margin="0,0,10,0"
                          SelectionChanged="FolderCombo_SelectionChanged">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource InstanceFolderLabel}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="VersionCombo" Grid.Column="1" SelectionChanged="VersionCombo_SelectionChanged"/>
            </Grid>

            <Grid x:Name="ModFilterRow" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ModFilterBox" MinWidth="80" MinHeight="32" VerticalContentAlignment="Center" TextChanged="ModFilter_Changed" ToolTip="筛选模组名称或文件名，不会清除隐藏的已选项目"/>
                <Button Grid.Column="1" Content="选择显示项" Margin="8,0,0,0" Padding="8,5" Click="SelectVisibleMods_Click"/>
                <Button Grid.Column="2" Content="批量操作" Margin="8,0,0,0" Padding="8,5" Click="MoreActions_Click">
                    <Button.ContextMenu><ContextMenu>
                        <MenuItem Header="启用已选模组…" Click="EnableSelectedMods_Click"/>
                        <MenuItem Header="禁用已选模组…" Click="DisableSelectedMods_Click"/>
                        <Separator/><MenuItem Header="清空选择" Click="ClearModSelection_Click"/>
                    </ContextMenu></Button.ContextMenu>
                </Button>
            </Grid>
            <StackPanel Grid.Row="3" Margin="0,0,0,6">
                <TextBlock x:Name="ModSelectionSummary" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ModMetadataStatus" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <ListBox x:Name="ModsListBox" Grid.Row="4" BorderThickness="0"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsBatchSelected}" Visibility="{Binding BatchSelectionVisibility}" Tag="{Binding}" Click="ModSelection_Click" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="选择此模组以批量启停"/>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}">
                                    <Run Text="{Binding FileName, Mode=OneWay}"/>
                                    <Run Text="  ·  "/><Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                    <Run Text="  ·  "/><Run Text="{Binding StatusLabel, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            </DockPanel>
                            <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Enable}" Margin="0,0,8,0" Padding="10,6"
                                    Style="{StaticResource SideNavButton}" Tag="{Binding}"
                                    Click="EnableMod_Click" Visibility="{Binding EnableButtonVisibility}"/>
                            <Button Grid.Column="2" Content="{DynamicResource Str_Ui_Disable}" Margin="0,0,8,0" Padding="10,6"
                                    Style="{StaticResource SideNavButton}" Tag="{Binding}"
                                    Click="DisableMod_Click" Visibility="{Binding DisableButtonVisibility}"/>
                            <Button Grid.Column="3" Content="{DynamicResource Str_Common_Delete}" Padding="10,6"
                                    Style="{StaticResource SideNavButton}" Tag="{Binding}" Click="DeleteMod_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint" Grid.Row="4" Text="{DynamicResource Str_Ui_No_Mods_Installed_For_This_Version_Yet_H}"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <ContentControl x:Name="LoadingHost" Grid.Row="4" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Border>
</UserControl>
