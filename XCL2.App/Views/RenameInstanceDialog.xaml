<local:OverlayDialogControl x:Class="XCL2.App.Views.RenameInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="380">
    
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource Str_Ui_New_Name}" Margin="0,0,0,6" />
        <TextBox x:Name="NameInputBox" Height="30" VerticalContentAlignment="Center" />
        <TextBlock x:Name="ErrorText" Foreground="IndianRed" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="OkBtn" Content="{DynamicResource Str_Common_Ok}" Width="80" Style="{DynamicResource PrimaryButton}" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</local:OverlayDialogControl>
