<local:OverlayDialogControl x:Class="XCL2.App.Views.SkinSelectWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            MinWidth="420"
                            MaxWidth="420"
                            MinHeight="420"
                            MaxHeight="420">
    
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20" Margin="10">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str_Ui_Choose_Offline_Skin}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Offline_Accounts_Can_Use_The_Built_In_St}"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <RadioButton x:Name="SteveRadio" Content="{DynamicResource Str_Ui_Steve_Default_Model}" GroupName="SkinType"
                         Margin="0,0,0,10" Checked="SkinTypeRadio_Checked"/>
            <RadioButton x:Name="AlexRadio" Content="{DynamicResource Str_Ui_Alex_Slim_Arm_Model}" GroupName="SkinType"
                         Margin="0,0,0,10" Checked="SkinTypeRadio_Checked"/>
            <RadioButton x:Name="CustomRadio" Content="{DynamicResource Str_Ui_Upload_Custom}" GroupName="SkinType"
                         Margin="0,0,0,10" Checked="SkinTypeRadio_Checked"/>

            <Border x:Name="CustomPanelBorder" Background="{DynamicResource SideBrush}" CornerRadius="8"
                    Padding="14" Margin="20,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BrowseSkinBtn" Content="{DynamicResource Str_Ui_Choose_A_Png_Image}" Click="BrowseSkin_Click" Padding="10,6"/>
                        <TextBlock x:Name="SkinFileNameText" Text="{DynamicResource Str_Ui_No_File_Selected}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <CheckBox x:Name="SlimArmCheck" Content="{DynamicResource Str_Ui_Slim_Arms_Alex_Model_Needed_By_Some_Cust}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="IndianRed" FontSize="12"
                       Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <TextBlock Text="{DynamicResource Str_Ui_Note_Custom_Skins_Need_Customskinloader_}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,16,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="OkBtn" Content="{DynamicResource Str_Common_Save}" Width="80" Style="{DynamicResource PrimaryButton}"
                        Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</local:OverlayDialogControl>
