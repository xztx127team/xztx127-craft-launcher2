<local:OverlayDialogControl x:Class="XCL2.App.Views.ModUpdateSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="600">
    
    <ScrollViewer x:Name="DialogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="发现可升级的模组" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="InstructionsText" Text="默认已全部勾选，取消勾选可以跳过某个模组不升级。" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SelectAllBtn" Content="全选" Padding="10,4" Margin="0,0,8,0" Click="SelectAll_Click"/>
            <Button x:Name="SelectNoneBtn" Content="全不选" Padding="10,4" Click="SelectNone_Click"/>
        </StackPanel>

        <ScrollViewer x:Name="CandidateScroll" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CandidateListControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <StackPanel>
                                <DockPanel>
                                <Button DockPanel.Dock="Right" Content="忽略此版本" Padding="8,4" Margin="8,0,0,0" Tag="{Binding}" Visibility="{Binding IgnoreVisibility}" Click="IgnoreVersion_Click"/>
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" FontWeight="SemiBold" FontSize="13" HorizontalContentAlignment="Stretch">
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                </CheckBox>
                                </DockPanel>
                                <TextBlock Text="{Binding VersionChangeText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="24,2,0,0" TextWrapping="Wrap"/>
                                <Expander Header="适配范围、依赖与更新说明" Margin="24,6,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,6"/>
                                        <TextBlock Text="{Binding DependencyText}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding UpdateNotes, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MaxHeight="180" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="SummaryText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="升级选中项" Width="110" Style="{DynamicResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</local:OverlayDialogControl>
