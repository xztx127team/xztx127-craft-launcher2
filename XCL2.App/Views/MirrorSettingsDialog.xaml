<local:OverlayDialogControl x:Class="XCL2.App.Views.MirrorSettingsDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:XCL2.App.Views" MinWidth="560" MaxWidth="960">
 <local:OverlayDialogControl.Resources>
  <Style x:Key="MirrorHeaderGrip" TargetType="Thumb">
   <Setter Property="Width" Value="5"/>
   <Setter Property="Cursor" Value="SizeWE"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="8,7,20,7"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="DataGridColumnHeader">
     <Grid>
      <Border x:Name="HeaderBackground" Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
              Padding="{TemplateBinding Padding}">
       <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         RecognizesAccessKey="True"/>
      </Border>
      <Path x:Name="SortArrow" Width="8" Height="4" Margin="0,0,7,0" HorizontalAlignment="Right"
            VerticalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}" Stretch="Uniform"
            IsHitTestVisible="False" Visibility="Collapsed"/>
      <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource MirrorHeaderGrip}"/>
      <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource MirrorHeaderGrip}"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBackground" Property="Background" Value="{DynamicResource GlowSoftBrush}"/></Trigger>
      <Trigger Property="SortDirection" Value="Ascending">
       <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
       <Setter TargetName="SortArrow" Property="Data" Value="M 0,4 L 4,0 L 8,4 Z"/>
      </Trigger>
      <Trigger Property="SortDirection" Value="Descending">
       <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
       <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,4 L 8,0 Z"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridRow">
   <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Style.Triggers>
    <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource SideBrush}"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource GlowSoftBrush}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource GlowSoftBrush}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="6,4"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="DataGridCell">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
      <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
     </Border>
    </ControlTemplate>
   </Setter.Value></Setter>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource GlowSoftBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="MirrorCellText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="MirrorCellEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="Padding" Value="3,2"/>
  </Style>
  <Style x:Key="MirrorCellCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="IsHitTestVisible" Value="False"/>
   <Setter Property="Focusable" Value="False"/>
  </Style>
  <Style x:Key="MirrorCellCheckEditor" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </local:OverlayDialogControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="680">
  <StackPanel Margin="24">
   <TextBlock Text="下载源与镜像管理" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
   <TextBlock Text="按下载源偏好排序；失败自动换源，并暂时降低故障主机的优先级。" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <TextBlock Text="游戏与加载器：BMCLAPI（bangbang93.com）与官方源相互回退。" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <CheckBox x:Name="CurseForgeCdnCheck" Content="优先使用 CurseForge 官方 CDN" Margin="0,0,0,4"/>
   <TextBlock Text="用于 CurseForge 模组与资源（含 NeoForge 模组）；NeoForge 安装器有对应 CDN 地址时优先使用，否则回退到 Maven 与镜像。" TextWrapping="Wrap" Opacity="0.75" Margin="20,0,0,10"/>
   <CheckBox x:Name="ModrinthCdnCheck" Content="优先使用 Modrinth 官方 CDN" Margin="0,0,0,4"/>
   <TextBlock Text="用于 Modrinth 模组、资源与整合包文件。官方 CDN 不可用时，仍可回退到已启用的社区镜像。" TextWrapping="Wrap" Opacity="0.75" Margin="20,0,0,12"/>
   <CheckBox x:Name="CommunityCheck" Content="启用社区资源镜像 MCIM（Modrinth / CurseForge 文件）" Margin="0,0,0,8"/>
   <CheckBox x:Name="GithubCheck" Content="启用 GitHub 公开文件镜像 GH-Proxy（.org / .com，同一运营方）" Margin="0,0,0,12"/>
   <TextBlock Text="第三方镜像可能延迟同步。下载保留官方清单提供的哈希和大小校验；支持作者可选择官网直接下载。CurseForge 未提供第三方下载链接的文件仍需从官网获取。" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16"/>
   <TextBlock Text="自定义镜像映射" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <TextBlock Text="填写原始 HTTPS 前缀与对应镜像前缀，保持其余路径不变。只添加你信任且规则明确的镜像。带账号、签名或未知查询参数的链接保持直连，不会交给镜像。" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="170" MaxHeight="300" SelectionMode="Single" HeadersVisibility="Column"
             Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
             BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" RowHeaderWidth="0"
             AlternationCount="2" GridLinesVisibility="Horizontal"
             HorizontalGridLinesBrush="{DynamicResource BorderBrush2}" VerticalGridLinesBrush="{DynamicResource BorderBrush2}">
    <DataGrid.Columns>
     <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="55" ElementStyle="{StaticResource MirrorCellCheck}" EditingElementStyle="{StaticResource MirrorCellCheckEditor}"/>
     <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110" ElementStyle="{StaticResource MirrorCellText}" EditingElementStyle="{StaticResource MirrorCellEditor}"/>
     <DataGridTextColumn Header="原始前缀" Binding="{Binding SourcePrefix}" Width="*" ElementStyle="{StaticResource MirrorCellText}" EditingElementStyle="{StaticResource MirrorCellEditor}"/>
     <DataGridTextColumn Header="镜像前缀" Binding="{Binding MirrorPrefix}" Width="*" ElementStyle="{StaticResource MirrorCellText}" EditingElementStyle="{StaticResource MirrorCellEditor}"/>
    </DataGrid.Columns>
   </DataGrid>
   <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
    <Button Content="添加" Click="Add_Click" Padding="14,7"/>
    <Button Content="删除选中" Click="Remove_Click" Padding="14,7" Margin="8,0,0,0"/>
    <Button Content="重置源健康记录" Click="ResetHealth_Click" Padding="14,7" Margin="8,0,0,0"/>
   </StackPanel>
   <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" Margin="0,0,0,8"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消" Click="Cancel_Click" Padding="18,8"/>
    <Button Content="保存" Click="Save_Click" Padding="18,8" Margin="8,0,0,0"/>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</local:OverlayDialogControl>
