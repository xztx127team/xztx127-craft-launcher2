<UserControl x:Class="XCL2.App.Views.BedrockMarketplacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:XCL2.App.Services"
             xmlns:controls="clr-namespace:XCL2.App.Views.Controls"
             Foreground="{DynamicResource TextPrimaryBrush}" Focusable="True">
    <UserControl.Resources>
        <Style x:Key="MarketButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarketPrimaryButton" TargetType="Button" BasedOn="{StaticResource MarketButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="MarketField" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarketFilter" TargetType="ComboBox" BasedOn="{StaticResource FilterComboBox}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style x:Key="MarketCard" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush2}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlowSoftBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" CornerRadius="14" Padding="22">
        <ScrollViewer x:Name="MarketViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      CanContentScroll="False" services:ScrollWheelBehavior.EnableFastWheel="True">
        <Grid MinWidth="516" Width="{Binding ViewportWidth, ElementName=MarketViewport}"
              Height="{Binding ViewportHeight, ElementName=MarketViewport}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="MinHeight" Value="820"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, ElementName=FileFiltersExpander}" Value="True">
                            <Setter Property="MinHeight" Value="960"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Width="38" Height="38" Padding="0" Margin="0,0,14,0"
                        Style="{StaticResource MarketButton}" Command="NavigationCommands.BrowseBack"
                        ToolTip="返回基岩版（Alt+←）" AutomationProperties.Name="返回基岩版">
                    <Path Data="M7,0 L0,7 7,14" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"
                          Width="8" Height="15" Stretch="Uniform"/>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="社区市场" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="发现行为包、资源包与附加内容" FontSize="12" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource SideBrush}" Padding="10,6"
                        VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="190">
                    <TextBlock x:Name="EntryContextText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource MarketField}" Padding="38,11,65,11"
                             FontSize="14" KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged"
                             ToolTip="按资源中英文名称搜索；Enter 搜索，Esc 清空，Ctrl+F 聚焦"
                             AutomationProperties.Name="搜索社区资源"/>
                    <Path Data="M14,7 A7,7 0 1 1 0,7 A7,7 0 1 1 14,7 M12,12 L18,18"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                          Width="18" Height="18" Stretch="Uniform" Margin="13,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="搜索资源名称…" Margin="39,0,0,0" VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="SearchClearButton" Content="清空" Style="{StaticResource MarketButton}"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0" Padding="9,5" MinHeight="28"
                            Click="ClearSearch_Click" AutomationProperties.Name="清空搜索"/>
                </Grid>
                <Button Grid.Column="1" x:Name="SearchButton" Content="搜索" Style="{StaticResource MarketPrimaryButton}"
                        Padding="22,10" Margin="10,0,0,0" Click="Search_Click"/>
                <Button Grid.Column="2" x:Name="CancelLoadingButton" Content="取消" Style="{StaticResource MarketButton}"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="CancelLoading_Click"/>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource SideBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <TextBlock Text="主题" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="CategoryFilter" Style="{StaticResource MarketFilter}" Width="108" SelectedIndex="0" SelectionChanged="ProjectFilters_Changed" AutomationProperties.Name="按主题筛选整个目录">
                                <ComboBoxItem Content="全部主题" Tag="0"/><ComboBoxItem Content="科技" Tag="1"/><ComboBoxItem Content="魔法" Tag="2"/>
                                <ComboBoxItem Content="冒险" Tag="3"/><ComboBoxItem Content="农业" Tag="4"/><ComboBoxItem Content="装饰" Tag="5"/>
                                <ComboBoxItem Content="实用" Tag="23"/><ComboBoxItem Content="辅助" Tag="24"/><ComboBoxItem Content="魔改" Tag="21"/><ComboBoxItem Content="前置" Tag="7"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                            <TextBlock Text="状态" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="StatusFilter" Style="{StaticResource MarketFilter}" Width="108" SelectedIndex="0" SelectionChanged="ProjectFilters_Changed" AutomationProperties.Name="按项目状态筛选整个目录">
                                <ComboBoxItem Content="全部状态" Tag="0"/><ComboBoxItem Content="活跃" Tag="1"/><ComboBoxItem Content="半弃坑" Tag="2"/><ComboBoxItem Content="停更" Tag="3"/>
                            </ComboBox>
                        </StackPanel>
                        <ComboBox x:Name="ProjectSortFilter" Style="{StaticResource MarketFilter}" Width="126" SelectedIndex="0" Margin="0,0,14,6" SelectionChanged="ProjectFilters_Changed" AutomationProperties.Name="目录排序">
                            <ComboBoxItem Content="默认排序" Tag="Default"/><ComboBoxItem Content="最新收录" Tag="Newest"/><ComboBoxItem Content="最近编辑" Tag="RecentlyUpdated"/>
                        </ComboBox>
                        <CheckBox x:Name="FuzzySearchFilter" Content="模糊搜索" VerticalAlignment="Center" FontSize="12" Margin="0,0,14,6"
                                  Checked="ProjectFilters_Changed" Unchecked="ProjectFilters_Changed" ToolTip="按原站提供的模糊搜索规则查找名称"/>
                        <Button Content="重置筛选" Style="{StaticResource MarketButton}" Padding="10,6" Margin="0,0,0,6" Click="ResetProjectFilters_Click"/>
                    </WrapPanel>
                    <ProgressBar x:Name="LoadingProgress" Grid.Row="1" Height="2" IsIndeterminate="True" Margin="0,6,0,0" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="11*" MinWidth="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="12*" MinWidth="280"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,10">
                        <TextBlock Text="发现资源" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                        <TextBlock x:Name="SearchStatusText" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ProjectList" Background="Transparent" BorderThickness="0" Padding="0,0,4,0"
                                 SelectionChanged="ProjectList_SelectionChanged" ItemContainerStyle="{StaticResource MarketCard}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 services:ScrollWheelBehavior.EnableFastWheel="True" AutomationProperties.Name="社区资源列表">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:BedrockResourceIcon Width="68" Height="68" SourceUrl="{Binding IconUrl}" FallbackText="{Binding Name}" Margin="0,0,13,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42"/>
                                        <TextBlock Text="{Binding EnglishName}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" MaxHeight="32" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Border Background="{DynamicResource SideBrush}" CornerRadius="5" Padding="6,3" HorizontalAlignment="Left" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Button Content="{Binding PublicationActionText}" IsEnabled="{Binding CanOpenPublicationPage}"
                                                Style="{StaticResource MarketButton}" Padding="8,4" MinHeight="26"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="ProjectPublicationPage_Click"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="{Binding PublicationActionHint}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ProjectEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False">
                            <Path Data="M0,7 L12,0 24,7 24,21 12,28 0,21 Z M0,7 L12,14 24,7 M12,14 L12,28" Width="42" Height="48" Stretch="Uniform"
                                  Stroke="{DynamicResource BorderBrush2}" StrokeThickness="1.4" HorizontalAlignment="Center"/>
                            <TextBlock Text="没有找到资源" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                            <TextBlock Text="试试其他名称，或重置筛选条件" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,8,4,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="PreviousButton" Content="上一页" Style="{StaticResource MarketButton}" IsEnabled="False" Click="Previous_Click"/>
                        <TextBlock x:Name="PageText" Grid.Column="1" Text="1 / 1" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button x:Name="NextButton" Grid.Column="2" Content="下一页" Style="{StaticResource MarketButton}" IsEnabled="False" Click="Next_Click"/>
                    </Grid>
                </Grid>

                <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" CornerRadius="14" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid x:Name="ProjectHeaderPanel">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <controls:BedrockResourceIcon Width="60" Height="60" SourceUrl="{Binding IconUrl}" FallbackText="{Binding Name}" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ProjectNameText" Text="选择一个资源" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="52"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="52" Margin="0,6,0,0">
                                    <TextBlock x:Name="ProjectSummaryText" Text="点击左侧卡片查看详情与下载版本" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </ScrollViewer>
                                <WrapPanel Margin="0,9,0,0">
                                    <Button x:Name="OpenPublicationPageButton" Content="打开发布页面" Style="{StaticResource MarketButton}"
                                            Padding="8,5" MinHeight="28" Margin="0,0,6,4" IsEnabled="False" Click="OpenPublicationPage_Click"/>
                                    <Button x:Name="OpenEncyclopediaPageButton" Content="百科页面" Style="{StaticResource MarketButton}"
                                            Padding="8,5" MinHeight="28" Margin="0,0,0,4" IsEnabled="False" Click="OpenEncyclopediaPage_Click"
                                            ToolTip="在浏览器中打开此资源的 MC百科介绍页面"/>
                                </WrapPanel>
                                <TextBlock x:Name="PublicationPageStatusText" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,16,0,8">
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="RetryFilesButton" DockPanel.Dock="Right" Content="刷新文件" Style="{StaticResource MarketButton}" Padding="8,4" MinHeight="26" Visibility="Collapsed" Click="RetryFiles_Click"/>
                                <TextBlock Text="下载版本" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Expander x:Name="FileFiltersExpander" IsExpanded="False" FontSize="12">
                                <Expander.Header>
                                    <TextBlock Text="筛选文件" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Expander.Header>
                                <StackPanel Margin="0,9,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="SourceFilter" Style="{StaticResource MarketFilter}" SelectedIndex="0" SelectionChanged="FileFilters_Changed" AutomationProperties.Name="筛选已加载文件的来源">
                                    <ComboBoxItem Content="全部来源" Tag="all"/><ComboBoxItem Content="GitHub" Tag="GitHub"/><ComboBoxItem Content="CurseForge" Tag="CurseForge"/>
                                </ComboBox>
                                <ComboBox x:Name="FileTypeFilter" Grid.Column="2" Style="{StaticResource MarketFilter}" SelectedIndex="0" SelectionChanged="FileFilters_Changed" AutomationProperties.Name="筛选已加载文件的格式">
                                    <ComboBoxItem Content="全部格式" Tag="all"/><ComboBoxItem Content="资源 / 行为包" Tag="mcpack"/><ComboBoxItem Content="附加包" Tag="mcaddon"/><ComboBoxItem Content="内容压缩包" Tag="zip"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="GameVersionFilter" Style="{StaticResource MarketField}" TextChanged="FileVersionFilter_TextChanged" ToolTip="只筛选已标明的游戏版本，例如 1.21；留空显示全部" AutomationProperties.Name="筛选文件已标明的游戏版本"/>
                                <TextBlock Text="游戏版本，如 1.21" FontSize="11" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=GameVersionFilter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <ComboBox x:Name="FileSortFilter" Grid.Column="2" Style="{StaticResource MarketFilter}" SelectedIndex="0" SelectionChanged="FileFilters_Changed" AutomationProperties.Name="已加载文件排序">
                                    <ComboBoxItem Content="最新发布" Tag="newest"/><ComboBoxItem Content="文件名称" Tag="name"/><ComboBoxItem Content="文件大小" Tag="size"/>
                                </ComboBox>
                            </Grid>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="重置" Style="{StaticResource MarketButton}" BorderThickness="0" MinHeight="24" Padding="7,3" Click="ResetFileFilters_Click"/>
                                <TextBlock x:Name="FileFilterStatusText" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <TextBlock x:Name="FileNoticeText" Grid.Row="2" FontSize="11" TextWrapping="Wrap" MaxHeight="64" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Grid Grid.Row="3" MinHeight="120">
                            <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Padding="0,0,3,0" ItemContainerStyle="{StaticResource MarketCard}" SelectionChanged="FileList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True" AutomationProperties.Name="可下载的包文件">
                                <ListBox.ItemTemplate><DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,5,0,0">
                                            <TextBlock Text="{Binding Version}" FontSize="10" Margin="0,0,9,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding GameVersions, StringFormat='游戏版本：{0}'}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding GameVersions}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="FileEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False">
                                <TextBlock Text="暂无可下载文件" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="可调整筛选条件，或选择其他资源" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush2}" Padding="0,12,0,0" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock x:Name="FileSizeText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button x:Name="DownloadButton" Content="选择位置并下载" Style="{StaticResource MarketPrimaryButton}" Padding="14,10" IsEnabled="False" Click="Download_Click" HorizontalAlignment="Stretch"/>
                                <TextBlock x:Name="DownloadStatusText" FontSize="11" TextWrapping="Wrap" MaxHeight="44" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <DockPanel Grid.Row="4" Margin="2,12,2,0">
                <TextBlock Text="MC百科社区目录" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" Margin="0,0,14,0"/>
                <TextBlock Text="文件直接保存到指定位置 · 下载进度在标题栏查看" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
        </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
