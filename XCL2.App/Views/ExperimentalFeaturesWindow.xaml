<local:OverlayDialogControl x:Class="XCL2.App.Views.ExperimentalFeaturesWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="520"
                            MaxWidth="520"
                            MinHeight="480"
                            MaxHeight="620">
                            <!-- MinHeight 必须给：该弹窗的布局里有 RowDefinition Height="*"。
                                 原来是 Window 且有固定 Height 时，"*"行能拿到剩余高度；
                                 改成挂在自适应 OverlayCard 里的 UserControl 之后，
                                 测量高度是无穷大，"*"行会塌陷成内容的期望高度——
                                 列表为空/WebView2 这种没有期望尺寸的控件会直接塌成 0，
                                 表现就是弹窗里一片空白。MinHeight 用回原来的设计高度即可。 -->
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource Str_Ui_Experimental_Features_2}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_These_Options_Are_Still_Being_Polished_A}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
            <StackPanel>

                <!-- 换肤功能已经全部做完（白/蓝/黄/紫/粉五个色系，各自都有浅色版/深色版），
                     不再是"实验性"的了，已经搬到「设置」页正式的「配色皮肤」下拉框 + 首页
                     「模式设置」按钮，这里不再重复放该入口，避免同一个功能出现在两个地方、
                     显示口径还可能不一致（比如这里之前只解锁了蓝色系，容易让人以为紫色/粉色
                     还没做完）。 -->

                <TextBlock Text="{DynamicResource Str_Ui_Early_Beta_Feature}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Str_Ui_Development_And_Concept_Builds_Only_Thin}"
                           Foreground="{DynamicResource WarningTextBrush}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <Button HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,8"
                        Click="MultiLoaderFeature_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧬" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Ui_Experimental_1_Install_Multiple_Loaders}" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Str_Ui_Install_Every_Loader_Into_The_Same_Insta}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="MiniWorldFeatureButton" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,8"
                        Click="MiniWorldFeature_Click">
                    <StackPanel>
                        <TextBlock Text="迷你世界 · 下载与启动（实验性）" FontWeight="Bold"/>
                        <TextBlock Text="官方与社区渠道 · 需先阅读作者声明并完成阅读确认"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="AdditionalFeaturesPanel"/>

                <!-- 原「启动基岩版」入口已整合进侧边栏独立页「基岩版启动」（BedrockPage），
                     不再放在实验性功能弹窗里。 -->

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Str_Ui_Want_Different_Colours_Use_Colour_Theme_}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="2" Content="{DynamicResource Str_Common_Close}" Style="{StaticResource PrimaryButton}" Click="Close_Click"/>
        </Grid>
    </Grid>
</local:OverlayDialogControl>
