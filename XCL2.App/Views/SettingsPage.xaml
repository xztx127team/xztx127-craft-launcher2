                                            <ComboBoxItem Content="自动" Tag="Auto"/><ComboBoxItem Content="B" Tag="B"/><ComboBoxItem Content="KiB" Tag="KiB"/><ComboBoxItem Content="MiB" Tag="MiB"/><ComboBoxItem Content="GiB" Tag="GiB"/>
                                        </ComboBox>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Width="340" Margin="0,0,12,12" Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource PanelBrush}">
