                                <CheckBox x:Name="PerformanceOverlayNpuCheck" Content="显示 NPU · 神经网络处理器" FontWeight="SemiBold" Margin="0,0,0,12" Checked="PerformanceHardwareToggle_Changed" Unchecked="PerformanceHardwareToggle_Changed"/>
                                <StackPanel x:Name="PerformanceOverlayNpuOptions">
                                    <CheckBox x:Name="PerformanceOverlayNpuUtilizationCheck" Content="显示使用率" Margin="0,0,0,6" Checked="PerformanceHardwareToggle_Changed" Unchecked="PerformanceHardwareToggle_Changed"/>
                                    <ComboBox x:Name="PerformanceOverlayNpuUtilizationFormatCombo" Margin="0,0,0,12" SelectionChanged="PerformanceHardwareChoice_Changed">
                                        <ComboBoxItem Content="百分比 · 0.0%" Tag="Percent"/><ComboBoxItem Content="整数百分比 · 0%" Tag="PercentInteger"/><ComboBoxItem Content="比例 · 0–1" Tag="Ratio"/>
                                    </ComboBox>
                                    <WrapPanel Margin="0,0,0,8">
                                        <CheckBox x:Name="PerformanceOverlayNpuDedicatedMemoryCheck" Content="显示专用内存" Width="175" VerticalAlignment="Center" Checked="PerformanceHardwareToggle_Changed" Unchecked="PerformanceHardwareToggle_Changed"/>
                                        <ComboBox x:Name="PerformanceOverlayNpuDedicatedMemoryUnitCombo" Width="100" ToolTip="专用内存显示单位，1024进制" SelectionChanged="PerformanceHardwareChoice_Changed">
                                            <ComboBoxItem Content="自动" Tag="Auto"/><ComboBoxItem Content="B" Tag="B"/><ComboBoxItem Content="KiB" Tag="KiB"/><ComboBoxItem Content="MiB" Tag="MiB"/><ComboBoxItem Content="GiB" Tag="GiB"/>
                                        </ComboBox>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="PerformanceOverlayNpuSharedMemoryCheck" Content="显示共享内存" Width="175" VerticalAlignment="Center" Checked="PerformanceHardwareToggle_Changed" Unchecked="PerformanceHardwareToggle_Changed"/>
                                        <ComboBox x:Name="PerformanceOverlayNpuSharedMemoryUnitCombo" Width="100" ToolTip="共享内存显示单位，1024进制" SelectionChanged="PerformanceHardwareChoice_Changed">
                                            <ComboBoxItem Content="自动" Tag="Auto"/><ComboBoxItem Content="B" Tag="B"/><ComboBoxItem Content="KiB" Tag="KiB"/><ComboBoxItem Content="MiB" Tag="MiB"/><ComboBoxItem Content="GiB" Tag="GiB"/>
                                        </ComboBox>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="PerformanceOverlayDiskCheck" Content="磁盘读写速率" Margin="0,0,16,6" Checked="PerformanceHardwareToggle_Changed" Unchecked="PerformanceHardwareToggle_Changed"/>
                        <CheckBox x:Name="PerformanceOverlayNetworkCheck" Content="网卡收发速率" Margin="0,0,16,6" Checked="PerformanceHardwareToggle_Changed" Unchecked="PerformanceHardwareToggle_Changed"/>
                    </WrapPanel>
                    <TextBlock Text="两类设备分别保存显示项目、使用率格式与内存单位。数据由 Windows / 驱动提供；没有支持的设备或读数时显示“暂不可用”，不显示为 0。NPU 不一定有专用内存。硬件选项会立即预览到已开启的悬浮窗，保存与撤销沿用本页设置。"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="显示游戏范围" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,8">
                        <ComboBox x:Name="PerformanceOverlayScopeCombo" Width="180" Margin="0,0,8,6" SelectionChanged="PerformanceOverlayScope_Changed">
                            <ComboBoxItem Content="所有运行中的游戏" Tag="All"/>
                            <ComboBoxItem Content="指定一个游戏实例" Tag="Selected"/>
                        </ComboBox>
                        <ComboBox x:Name="PerformanceOverlayInstanceCombo" Width="280" Margin="0,0,8,6" DisplayMemberPath="Label" SelectedValuePath="Id"/>
                        <Button x:Name="PerformanceOverlayRefreshGamesButton" Content="刷新运行实例" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,0,6" Click="PerformanceOverlayRefreshGames_Click"/>
                    </WrapPanel>
                    <TextBlock Text="实例按游戏目录标识区分；同名实例可用 PID 区分。指定实例退出后继续保留选择，不会自动切到其他实例。"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Border x:Name="PerformanceOverlayLayoutPanel" Padding="16" Margin="0,8,0,16" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource PanelBrush}">
                        <StackPanel>
                            <TextBlock Text="布局、字段模板与换行" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <StackPanel Margin="0,0,14,10">
                                    <TextBlock Text="内容布局" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="PerformanceOverlayLayoutModeCombo" Width="180">
                                        <ComboBoxItem Content="保留现有布局（默认）" Tag="Default"/>
                                        <ComboBoxItem Content="使用自定义字段模板" Tag="Template"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,10">
                                    <TextBlock Text="统一换行方式" FontSize="12" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="PerformanceOverlayLineBreakCombo" Width="180">
                                        <ComboBoxItem Content="全部保留换行" Tag="Preserve"/>
                                        <ComboBoxItem Content="全部取消换行 · 单行" Tag="SingleLine"/>
                                        <ComboBoxItem Content="每项独立一行" Tag="EachField"/>
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="全部取消换行" Style="{StaticResource CompactActionButton}" Margin="0,0,8,6" Click="PerformanceSingleLine_Click"/>
                                <Button Content="全部保留换行" Style="{StaticResource CompactActionButton}" Margin="0,0,8,6" Click="PerformancePreserveLines_Click"/>
                                <CheckBox x:Name="PerformanceOverlayAutoWrapCheck" Content="超出窗口宽度时自动换行" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            </WrapPanel>
                            <TextBlock Text="单行模式会关闭自动折行，超出窗口宽度可横向滚动；保留换行时沿用现有布局或模板里的回车。下面和上方的显示项目勾选始终有效。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <StackPanel x:Name="PerformanceTemplateEditorPanel">
                                <TextBlock Text="字段模板（按 Enter 插入换行，最多 4096 字符）" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="PerformanceOverlayTemplateBox" MinHeight="110" MaxHeight="240" MaxLength="4096" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontFamily="Consolas"/>
                                <WrapPanel Margin="0,8,0,6">
                                    <ComboBox x:Name="PerformanceTemplateFieldCombo" Width="300" MaxWidth="400" DisplayMemberPath="Label" Margin="0,0,8,6"/>
                                    <Button Content="插入字段" Style="{StaticResource CompactActionButton}" Margin="0,0,8,6" Click="InsertPerformanceField_Click"/>
                                    <Button Content="恢复默认模板" Style="{StaticResource CompactActionButton}" Margin="0,0,8,6" Click="ResetPerformanceTemplate_Click"/>
                                </WrapPanel>
                                <TextBlock Text="字段自带名称与单位。只替换已勾选的项目；取消 GPU、NPU 或其子指标后，对应字段留空。多张设备和游戏按当前范围显示。固定文字按原样显示。未知字段会提示并忽略；花括号用 {{ 和 }} 显示，不执行表达式。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            </StackPanel>
                            <TextBlock x:Name="PerformanceTemplateWarningText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="当前字段预览" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <Border x:Name="PerformanceTemplatePreviewFrame" MaxWidth="{Binding ActualWidth, ElementName=PerformanceOverlayLayoutPanel}" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource SideBrush}" CornerRadius="8" Padding="12,9">
                                <ScrollViewer x:Name="PerformanceTemplatePreviewScroll" MaxHeight="220" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="PerformanceTemplatePreviewText" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                            <TextBlock x:Name="PerformanceTemplateSampleText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="样式" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PerformanceOverlayStyleCombo" Width="130">
                                <ComboBoxItem Content="简洁" Tag="Compact"/><ComboBoxItem Content="详细" Tag="Detailed"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="配色" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PerformanceOverlayColorCombo" Width="130">
                                <ComboBoxItem Content="跟随启动器" Tag="Theme"/><ComboBoxItem Content="深色" Tag="Dark"/><ComboBoxItem Content="浅色" Tag="Light"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="窗口宽度" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PerformanceOverlayWidthCombo" Width="130">
                                <ComboBoxItem Content="随样式自动" Tag="0"/>
                                <ComboBoxItem Content="280" Tag="280"/><ComboBoxItem Content="320" Tag="320"/>
                                <ComboBoxItem Content="420" Tag="420"/><ComboBoxItem Content="520" Tag="520"/><ComboBoxItem Content="600" Tag="600"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="游戏排序" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PerformanceOverlaySortCombo" Width="130">
                                <ComboBoxItem Content="按实例名称" Tag="Name"/><ComboBoxItem Content="CPU 从高到低" Tag="Cpu"/><ComboBoxItem Content="内存从高到低" Tag="Memory"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="刷新间隔" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PerformanceOverlayRefreshCombo" Width="130">
                                <ComboBoxItem Content="0.5 秒" Tag="500"/><ComboBoxItem Content="1 秒" Tag="1000"/>
                                <ComboBoxItem Content="2 秒" Tag="2000"/><ComboBoxItem Content="5 秒" Tag="5000"/><ComboBoxItem Content="10 秒" Tag="10000"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,10">
                            <TextBlock Text="系统 / 进程内存单位" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PerformanceOverlayMemoryUnitCombo" Width="130">
                                <ComboBoxItem Content="自动" Tag="Auto"/><ComboBoxItem Content="MB" Tag="MB"/><ComboBoxItem Content="GB" Tag="GB"/>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <StackPanel Margin="0,0,20,8">
                            <DockPanel Width="200">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=PerformanceOverlayFontSlider, Path=Value, StringFormat='{}{0:0}'}"/>
                                <TextBlock Text="字号（10–26）" FontSize="12"/>
                            </DockPanel>
                            <Slider x:Name="PerformanceOverlayFontSlider" Minimum="10" Maximum="26" Value="14" TickFrequency="1" IsSnapToTickEnabled="True" Width="200"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <DockPanel Width="240">
                                <TextBlock DockPanel.Dock="Right"><Run Text="{Binding ElementName=PerformanceOverlayOpacitySlider, Path=Value, StringFormat='{}{0:0}'}"/><Run Text="%"/></TextBlock>
                                <TextBlock Text="不透明度" FontSize="12"/>
                            </DockPanel>
                            <Slider x:Name="PerformanceOverlayOpacitySlider" Minimum="25" Maximum="100" Value="90" TickFrequency="1" IsSnapToTickEnabled="True" Width="240"/>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="PerformanceOverlayTopmostCheck" Content="固定在最上层" Margin="0,0,20,6"/>
                        <CheckBox x:Name="PerformanceOverlayLockCheck" Content="锁定位置" Margin="0,0,20,6"/>
                    </WrapPanel>
                    <Button Content="硬件详情 · 厂商、速率与内存通道…" Click="PerformanceHardwareDetails_Click"
                            Style="{StaticResource CompactActionButton}" HorizontalAlignment="Left" Padding="11,5" Margin="0,0,0,8"/>
                    <TextBlock Text="默认关闭鼠标穿透，可直接拖动悬浮窗主体或右键设置。仅在开启穿透时显示小齿轮：点击打开原右键菜单，按住拖动可移动位置。菜单和硬件详情中的保存立即生效；本页其余设置沿用本页保存方式。关闭悬浮窗后停止采样。"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <TextBlock Text="启动器更新" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
            <CheckBox x:Name="CheckLauncherUpdatesOnStartupCheck" Content="启动时检查启动器更新"
                      Margin="0,0,0,8"/>
            <CheckBox x:Name="EnableLauncherUpdatesCheck" Content="允许下载安装启动器更新"
                      Margin="0,0,0,6" Checked="LauncherUpdateSettings_Changed" Unchecked="LauncherUpdateSettings_Changed"/>
            <TextBlock Text="关闭启动检查后仍可手动检查；关闭下载安装时仅查看可选更新。发布者要求必须安装的更新，以及已过安装期限的更新，仍需安装后才能继续使用。设置遵循本页的保存方式。"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button x:Name="CheckLauncherUpdateBtn" Content="检查更新" Style="{StaticResource CompactActionButton}"
                    HorizontalAlignment="Left" Padding="11,5" Margin="0,0,0,8" Click="CheckLauncherUpdate_Click"/>
            <TextBlock x:Name="LauncherUpdateStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,20" AutomationProperties.LiveSetting="Polite"/>

            <!-- 普通模式下才显示：简化版 Java 版本选择，只给 Java 8 / 17 / 21 / 25 四个选项，
                 每个选项对应一段能大致覆盖的游戏版本区间，帮用户不用去查资料就能选对。
                 选中项直接决定"一键下载 Java"下载哪个版本；不涉及架构/安装方式，
                 这两项在普通模式下走固定的推荐值（当前系统架构 + 便携安装），
                 Java 8 除外——它默认使用 32 位，其余版本默认使用 64 位（见下方架构提示）。 -->
            <StackPanel x:Name="SimpleJavaPanel" Margin="0,0,0,10">
                <TextBlock Text="{DynamicResource Str_Ui_Java_Version}" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <ComboBox x:Name="SimpleJavaVersionCombo" Width="260" HorizontalAlignment="Left">
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Java_8_For_Versions_Before_1_16}" Tag="8"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Java_17_For_Versions_Before_1_20_5}" Tag="17"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Java_21_For_Versions_Before_1_21_11}" Tag="21"/>
                    <ComboBoxItem Content="{DynamicResource Str_Ui_Java_25_For_26_1_And_Later}" Tag="25"/>
                </ComboBox>
                <TextBlock Text="{DynamicResource Str_Ui_Note_Java_8_Defaults_To_32_Bit_And_Every}"
                           Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 高级模式下才显示：Java 版本 / 架构 / 安装方式选择。
                 放在"下载 Java"按钮上面——因为高级模式下点"下载 Java"读的就是这里选的版本/架构/
                 安装方式，选择应该在动作之前，原来的顺序是反的（选项在下载按钮下面），容易让人先
                 点了下载才看到还有版本可选，现在调整成先选、后点下载，符合从上到下的操作顺序。 -->
            <StackPanel x:Name="AdvancedJavaPanel" Margin="0,0,0,10" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource Str_Ui_Java_Version_Architecture_Install_Type_A}" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="JavaVersionCombo" Width="110" Margin="0,0,8,0"/>
                    <ComboBox x:Name="JavaArchCombo" Width="90" Margin="0,0,8,0">
                        <ComboBoxItem Content="x64" Tag="x64"/>
                        <ComboBoxItem Content="x86" Tag="x86"/>
                    </ComboBox>
                    <ComboBox x:Name="JavaInstallModeCombo" Width="160">
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Portable_Zip_No_Installer}" Tag="Portable"/>
                        <ComboBoxItem Content="{DynamicResource Str_Ui_Install_System_Wide_Msi}" Tag="System"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="{DynamicResource Str_Ui_Note_The_Officially_Released_Versions_Ar}"
                           Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                
                <TextBlock Text="{DynamicResource Str_Ui_For_Reference_Java_8_Covers_Versions_Bef}"
                           Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <!-- 强制使用匹配 Java：默认关闭，只是"建议"（弹窗可以选择仍然使用）。打开后启动前
                     检测到 Java 版本不匹配会直接自动切换，不再提供"仍然使用"的选项。
                     见 MainWindow.xaml.cs LaunchInternalAsync 里的版本匹配检查。 -->
                <CheckBox x:Name="EnforceJavaVersionMatchCheck" Content="{DynamicResource Str_Ui_Always_Use_The_Matching_Java_Switch_Auto}"
                          Margin="0,10,0,0"/>
            </StackPanel>

            
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Str_Ui_Downloaded_Java_Runtimes_Are_Added_To_Th}"
                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" x:Name="DownloadJavaBtn" Content="{DynamicResource Str_Ui_Download_Java}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,8" Click="DownloadJava_Click"/>
            </Grid>

            <!-- 全盘扫描默认不开启：只在用户主动点击后才弹二次确认，说明扫描范围，
                 同意后才会真正开始遍历磁盘；默认行为(FindJava)完全不受影响，只看默认路径。 -->
            <Button Style="{StaticResource CompactActionButton}" x:Name="ScanDiskForJavaBtn" Content="{DynamicResource Str_Ui_Scan_The_Whole_Disk_For_Java_Optional_Of}"
                    HorizontalAlignment="Left" Padding="11,5" Margin="0,4,0,16"
                    Click="ScanDiskForJava_Click"/>

            <!-- Java 列表：多个 Java 运行时可以同时登记在案（多 Java 共存），
                 客户端每个版本、服务器每个实例都能各自从该列表里选择要用哪一个。 -->
            <TextBlock Text="{DynamicResource Str_Ui_Java_List_Multiple_Java_Runtimes}" FontSize="14" FontWeight="Bold" Margin="0,4,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Once_Several_Java_Runtimes_Are_Registere}"
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <ListBox x:Name="JavaListBox" Height="120" Margin="0,0,0,8"
                     DisplayMemberPath="DisplayText"/>

            <!-- 优先级排序：上移/下移调整 Java 列表顺序，FindJava 自动匹配(没有为某个版本/服务器
                 单独指定 Java 时)会按该顺序从高到低依次尝试，选第一个跟当前 MC 版本兼容的那个。
                 之前只能通过"全局默认 Java"强制指定一个，覆盖不到所有场景(比如同时有需要
                 Java 21 的新版本和需要 Java 8 的老 mod)；现在维护一份优先级列表，不同版本各自
                 匹配到列表里排最靠前、又满足版本要求的那个，不需要来回手动切换。 -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource CompactActionButton}" Content="{DynamicResource Str_Ui_Move_Up}" Padding="11,5" Margin="0,0,8,0" Click="MoveJavaUp_Click"
                        ToolTip="{DynamicResource Str_Ui_Move_The_Selected_Java_One_Place_Up_Auto}"/>
                <Button Style="{StaticResource CompactActionButton}" Content="{DynamicResource Str_Ui_Move_Down}" Padding="11,5" Click="MoveJavaDown_Click"
                        ToolTip="{DynamicResource Str_Ui_Move_The_Selected_Java_One_Place_Down}"/>
            </WrapPanel>

            <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource CompactActionButton}" Content="{DynamicResource Str_Ui_Refresh_Auto_Detect}" Padding="11,5" Margin="0,0,8,0" Click="RefreshDetectJava_Click"
