<UserControl x:Class="XCL2.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:XCL2.App.Services"
             xmlns:local="clr-namespace:XCL2.App.Views">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
        <AdornerDecorator>
        <StackPanel x:Name="SettingsRootPanel">
            <TextBlock Text="{DynamicResource Str_Settings_Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- 设置搜索：设置页条目太多，靠肉眼从上滑到下找一个开关越来越费劲。这里只做
                 "在本页已有控件里查找文字并跳转/高亮"，不重新组织页面结构——每敲一个字符
                 防抖 300ms 后重新搜一次，命中就把第一个匹配项滚动到可视区域并临时高亮，
                 方便看清楚具体是哪一项。 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="SettingsSearchBox" Padding="8,6"
                             TextChanged="SettingsSearchBox_TextChanged" ToolTip="搜索设置 · Ctrl+F；Enter 下一个，Shift+Enter 上一个，Esc 清空" AutomationProperties.Name="搜索设置"/>
                    <TextBlock x:Name="SettingsSearchPlaceholder" Text="在此搜索设置项"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.72"/>
                </Grid>
                <TextBlock x:Name="SettingsSearchResultText" Grid.Column="1" Margin="10,0,0,0" FontSize="12" MaxWidth="160" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <!-- 「↑ / ↓」：在所有命中项之间循环跳转。搜索本身只会把第一个命中项滚进视野，
                     设置页很长、同一个关键词常常命中好几处，没有这两个按钮就只能自己手动往下翻找。
                     跳转是循环的（到底了再点 ↓ 会回到第一个），当前是第几个/共几个显示在
                     左边的 SettingsSearchResultText 里，见 SettingsPage.xaml.cs 的
                     GoToSettingsSearchMatch。没有关键词/没有命中时两个按钮自动禁用。 -->
                <WrapPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <!-- 用箭头符号而不是"上"/"下"两个汉字：这两个按钮只有 36px 宽，汉字在该
                         尺寸下既挤又不如箭头一眼能懂；↑/↓ 也跟浏览器/编辑器里"查找上一个/下一个"
                         的通行图标一致，不需要认字就知道是干什么的。用 Segoe UI Symbol 里的
                         U+2191/U+2193，不引外部图标字体，保证在任何 Windows 上都画得出来。 -->
                    <Button Style="{StaticResource QuietActionButton}" x:Name="SettingsSearchPrevBtn" Content="&#x2191;" FontSize="15" Width="36" Padding="0,2" IsEnabled="False"
                            ToolTip="跳到上一个包含该关键词的设置项" Click="SettingsSearchPrev_Click"
                            AutomationProperties.Name="上一个搜索结果"/>
                    <Button Style="{StaticResource QuietActionButton}" x:Name="SettingsSearchNextBtn" Content="&#x2193;" FontSize="15" Width="36" Padding="0,2" Margin="6,0,0,0" IsEnabled="False"
                            ToolTip="跳到下一个包含该关键词的设置项" Click="SettingsSearchNext_Click"
                            AutomationProperties.Name="下一个搜索结果"/>
                </WrapPanel>
            </Grid>


            <!-- 普通/高手模式：这是全局唯一的模式设置入口。勾选后当前设置页会立即切换
                 Java 高级选项的显隐作为预览，但配置仍遵循本页统一保存策略：自动保存关闭时
                 需要点击底部“保存设置”，开启自动保存时由统一防抖逻辑保存。 -->
            <CheckBox x:Name="AdvancedModeCheck" Content="{DynamicResource Str_Ui_Expert_Mode_Tweak_The_Java_Version_Archi}"
                      Margin="0,0,0,4" Checked="AdvancedModeCheck_Changed" Unchecked="AdvancedModeCheck_Changed"/>
            <TextBlock x:Name="AdvancedModeHintText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,16" TextWrapping="Wrap"/>

            <!-- 简洁模式：跟首页右上角的同款开关共享同一个配置项（cfg.SimplifiedModeEnabled），
                 两处操作互相同步。点击立即生效（不遵循本页"点保存设置才生效"的统一策略），
                 跟 AdvancedMode 在首页/设置页两处入口保持同样的"哪边改都立即写回"的语义。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="AI 执行记录保留时间：" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="AiActivityRetentionBox" Width="80" Margin="6,0,6,0" VerticalContentAlignment="Center"
                         ToolTip="留空、0、∞ 或 A 表示不限制（默认）；可填秒数或选择分钟 / 小时 / 天。按 Enter 或离开输入框时保存。"
                         AutomationProperties.Name="AI 执行记录保留时间" LostFocus="AiActivityRetention_Changed"
                         KeyDown="AiActivityRetentionBox_KeyDown"/>
                <ComboBox x:Name="AiActivityRetentionUnitCombo" Width="80" SelectedIndex="3" AutomationProperties.Name="AI 执行记录保留时间单位"
                          SelectionChanged="AiActivityRetention_Changed">
                    <ComboBoxItem Content="秒"/><ComboBoxItem Content="分钟"/><ComboBoxItem Content="小时"/><ComboBoxItem Content="天"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="输入 A 表示无限时间（不限制）；也可以输入数字指定保留时间。随意调整造成的数据丢失，作者不承担任何责任！" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
            <CheckBox x:Name="SimplifiedModeCheck" Content="简洁模式：侧边栏只保留最常用的几个入口，其余功能收进「更多」"
                      Margin="0,0,0,16" Checked="SimplifiedModeCheck_Changed" Unchecked="SimplifiedModeCheck_Changed"/>

            <Expander x:Name="WindowsCompatibilitySettingsGroup" Header="Windows 兼容模式" Margin="0,0,0,20">
                <StackPanel Margin="0,10,0,0">
                    <ComboBox x:Name="WindowsCompatibilityModeCombo" Width="280" HorizontalAlignment="Left"
                              AutomationProperties.Name="Windows 兼容模式"
                              SelectionChanged="WindowsCompatibilityModeCombo_SelectionChanged">
                        <ComboBoxItem Content="自动（Windows 8.1 及更早版本开启）" Tag="Auto"/>
                        <ComboBoxItem Content="开启兼容模式" Tag="Enabled"/>
                        <ComboBoxItem Content="关闭兼容模式" Tag="Disabled"/>
                    </ComboBox>
                    <TextBlock x:Name="WindowsCompatibilityStatusText" TextWrapping="Wrap" Margin="0,8,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="Vista / Windows 7 使用完整兼容层；Windows 8 / 8.1 使用普通兼容层。Windows 10 及以上手动开启时使用普通兼容层。更改遵循本页保存设置；已存在的窗口和连接建议重启后重新建立。"
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Expander>

            <Expander x:Name="SidebarAppearanceSettingsGroup" Header="侧边栏位置与文字" Margin="0,0,0,20">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="新旧界面均可使用。留空的导航名称跟随界面语言；修改名称不会改变入口对应的功能。"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="80" MaxWidth="160"/>
                            <ColumnDefinition Width="3*" MaxWidth="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="显示位置" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SidebarPlacementCombo" Grid.Column="1" AutomationProperties.Name="侧边栏显示位置">
                            <ComboBoxItem Content="左侧（默认）" Tag="Left"/>
                            <ComboBoxItem Content="右侧" Tag="Right"/>
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="SidebarAutomaticWidthCheck" Content="使用默认侧边栏宽度" Margin="0,0,0,6"
                              Checked="SidebarDimensionDefault_Changed" Unchecked="SidebarDimensionDefault_Changed"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="80" MaxWidth="160"/>
                            <ColumnDefinition Width="3*" MaxWidth="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="展开宽度" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Slider x:Name="SidebarWidthSlider" Grid.Column="1" Minimum="160" Maximum="360" TickFrequency="10"
                                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" AutomationProperties.Name="侧边栏展开宽度"/>
                        <TextBlock Grid.Column="2" Text="{Binding ElementName=SidebarWidthSlider, Path=Value, StringFormat=' {0:0}'}" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="SidebarAutomaticFontSizeCheck" Content="使用默认导航字号" Margin="0,0,0,6"
                              Checked="SidebarDimensionDefault_Changed" Unchecked="SidebarDimensionDefault_Changed"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="80" MaxWidth="160"/>
                            <ColumnDefinition Width="3*" MaxWidth="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="导航文字大小" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Slider x:Name="SidebarFontSizeSlider" Grid.Column="1" Minimum="11" Maximum="22" TickFrequency="1"
                                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" AutomationProperties.Name="导航文字大小"/>
                        <TextBlock Grid.Column="2" Text="{Binding ElementName=SidebarFontSizeSlider, Path=Value, StringFormat=' {0:0}'}" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="SidebarShowIconsCheck" Content="展开时显示导航图标" Margin="0,0,0,8"/>
                    <CheckBox x:Name="SidebarStartCollapsedCheck" Content="下次启动时收起侧边栏" Margin="0,0,0,12"/>
                    <Expander Header="自定义导航文字" Margin="0,0,0,12">
                        <StackPanel x:Name="SidebarLabelsPanel" Margin="0,10,0,0"/>
                    </Expander>
                    <Button Content="恢复侧边栏默认设置" Style="{StaticResource CompactActionButton}"
                            HorizontalAlignment="Left" Padding="11,5" Click="ResetSidebarPreferences_Click"/>
                </StackPanel>
            </Expander>

            
            <TextBlock Text="{DynamicResource Str_Settings_LanguageSection_Title}" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Settings_LanguageSection_Hint}" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <Button x:Name="OpenLanguagePickerBtn" Content="{DynamicResource Str_Settings_LanguageSection_OpenPicker}"
                    Style="{StaticResource CompactActionButton}" HorizontalAlignment="Left" Padding="11,5"
                    Margin="0,0,0,20" Click="OpenLanguagePicker_Click"/>

            <Button Style="{StaticResource CompactActionButton}" x:Name="ReopenWizardBtn" Content="{DynamicResource Str_Ui_Reopen_Setup_Wizard}" HorizontalAlignment="Left" Padding="11,5" Margin="0,0,0,16"
                    Click="ReopenWizard_Click"/>

            <!-- 窗口与托盘：点击标题栏叉号时的默认行为 + 开机自启动。
                 这些项目跟其它普通设置一样统一由“保存设置/自动保存”流程持久化。 -->
            <TextBlock Text="窗口与托盘" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="点击标题栏叉号(关闭按钮)时" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CloseActionCombo" Width="260" HorizontalAlignment="Left" Margin="0,0,0,10"
                      SelectionChanged="CloseActionCombo_SelectionChanged">
                <ComboBoxItem Content="直接关闭启动器"/>
                <ComboBoxItem Content="最小化到系统托盘"/>
                <ComboBoxItem Content="最小化（仅收进任务栏，不显示托盘图标）"/>
                <ComboBoxItem Content="每次都弹窗询问"/>
            </ComboBox>
            <Grid Margin="0,0,0,10" MaxWidth="620" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox x:Name="AutoStartOnBootCheck" Content="开机自启动" VerticalAlignment="Center"
                          Checked="AutoStartOnBootCheck_Changed" Unchecked="AutoStartOnBootCheck_Changed"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="自启动后" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="AutoStartLaunchBehaviorCombo" Width="190" Padding="6">
                        <ComboBoxItem Content="弹出主界面"/>
                        <ComboBoxItem Content="最小化到任务栏"/>
                        <ComboBoxItem Content="隐藏到系统托盘"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="游戏启动成功后，启动器窗口" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="PostGameLaunchActionCombo" Width="300" HorizontalAlignment="Left" Margin="0,0,0,20"
                      SelectionChanged="PostGameLaunchActionCombo_SelectionChanged">
                <ComboBoxItem Content="保持不变（默认）"/>
                <ComboBoxItem Content="最小化到任务栏"/>
                <ComboBoxItem Content="最小化到系统托盘"/>
                <ComboBoxItem Content="直接关闭启动器"/>
            </ComboBox>

            <Expander x:Name="UxHabitsSettingsGroup" Header="使用习惯、隐私与显示" Margin="0,0,0,20">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="这些选项只影响展示与本地使用记录。收藏、导出、清理等入口放在对应页面，需要时再打开。可编辑设置支持右键恢复单项或本组默认值。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,12"/>
                    <CheckBox x:Name="UxRecentHistoryCheck" Content="记录最近启动的实例" Margin="0,0,0,8"/>
                    <CheckBox x:Name="UxRecentToolsCheck" Content="记录最近使用的工具" Margin="0,0,0,8"/>
                    <Button Content="清空最近使用记录" Click="UxClearRecent_Click" HorizontalAlignment="Left" Padding="11,5" Margin="0,0,0,12" Style="{StaticResource CompactActionButton}"/>
                    <CheckBox x:Name="UxRememberBrowseCheck" Content="从实例详情返回时恢复筛选条件与浏览位置" Margin="0,0,0,8"/>
                    <CheckBox x:Name="UxRememberResultsCheck" Content="保留本次会话的任务结果（最多 100 条，退出后清空）" Margin="0,0,0,8"/>
                    <Button Content="清空本次任务结果" Click="UxClearResults_Click" HorizontalAlignment="Left" Padding="11,5" Margin="0,0,0,12" Style="{StaticResource CompactActionButton}"/>
                    <CheckBox x:Name="UxHideServerAddressesCheck" Content="隐藏服务器地址" Margin="0,0,0,8"/>
                    <CheckBox x:Name="UxRememberWindowCheck" Content="记住主窗口位置，显示器断开后移回可见区域" Margin="0,0,0,8"/>
                    <CheckBox x:Name="UxFollowReducedMotionCheck" Content="跟随系统的减少动画偏好" Margin="0,0,0,12"/>
                    <TextBlock Text="时间显示" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="UxTimeFormatCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="跟随系统" Tag="System"/>
                        <ComboBoxItem Content="12 小时制" Tag="TwelveHour"/>
                        <ComboBoxItem Content="24 小时制" Tag="TwentyFourHour"/>
                    </ComboBox>
                    <TextBlock Text="容量单位" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="UxCapacityUnitCombo" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="自动选择合适单位" Tag="Automatic"/>
                        <ComboBoxItem Content="MB" Tag="MB"/>
                        <ComboBoxItem Content="GB" Tag="GB"/>
                    </ComboBox>
                    <CheckBox x:Name="UxExactCapacityCheck" Content="同时显示精确字节数" Margin="0,0,0,12"/>
                    <Button Content="恢复界面布局…" Click="UxResetLayout_Click" HorizontalAlignment="Left" Padding="11,5" Style="{StaticResource CompactActionButton}"
                            ToolTip="恢复窗口、搜索框与下载面板布局，不影响账号和游戏文件"/>
                </StackPanel>
            </Expander>
            <Expander x:Name="RecoverySettingsGroup" Header="提醒、启动检查与恢复" Margin="0,0,0,20">
                <StackPanel Margin="0,10,0,0">
                    <CheckBox x:Name="ReminderBadgeCheck" Content="显示右下角提醒角标" Margin="0,0,0,8"/>
                    <TextBlock Text="后台建议只增加角标，点击后查看详情。你主动执行操作时的确认、错误反馈，以及自己设置的模组更新提醒方式保持原样。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"/>
                    <CheckBox x:Name="LaunchHealthCheck" Content="启动前检查实例完整性" Margin="0,0,0,6"/>
                    <ComboBox x:Name="LaunchHealthModeCombo" Width="240" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="轻量检查（默认）" Tag="Simple"/>
                        <ComboBoxItem Content="完整检查（逐个核对大小）" Tag="Strict"/>
                    </ComboBox>
                    <CheckBox x:Name="RememberDownloadsCheck" Content="保存可恢复的下载任务" Margin="0,0,0,6"/>
                    <TextBlock Text="重启后将支持恢复的原版安装任务放回下载管理，保持暂停，点击继续才联网。完成的文件会复用，未完成文件按服务器支持情况续传。不会自动重跑脚本或安装进程。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ModSnapshotCheck" Content="更新模组 / 资源包前保存原文件快照" Margin="0,0,0,8"/>
                    <TextBlock Text="保留快照数量（1–100）" FontSize="12"/>
                    <Slider x:Name="ModSnapshotCountSlider" Minimum="1" Maximum="100" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" Width="250" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding ElementName=ModSnapshotCountSlider, Path=Value, StringFormat='当前保留 {0:0} 份'}" FontSize="11"/>
                    <TextBlock Text="快照总空间上限（64–16384 MB）" FontSize="12" Margin="0,8,0,0"/>
                    <Slider x:Name="ModSnapshotSpaceSlider" Minimum="64" Maximum="16384" Value="1024" TickFrequency="64" IsSnapToTickEnabled="True" Width="250" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding ElementName=ModSnapshotSpaceSlider, Path=Value, StringFormat='当前上限 {0:0} MB'}" FontSize="11"/>
                    <TextBlock Text="轮换时仅清理旧的已完成快照；未完成快照会保留供核对。快照失败时停止更新，恢复前检查文件是否有后续修改。AI 文件编辑继续使用原有的完整备份与回滚。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,10"/>
                    <WrapPanel>
                        <Button Content="查看提醒" Click="OpenReminders_Click" Style="{StaticResource CompactActionButton}" Padding="11,5" Margin="0,0,8,0"/>
                        <Button Content="查看更新快照" Click="OpenModSnapshots_Click" Style="{StaticResource CompactActionButton}" Padding="11,5"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <Expander x:Name="PerformanceOverlaySettingsGroup" Header="性能悬浮窗 · 系统与游戏占用" Margin="0,0,0,20">
                <StackPanel Margin="0,10,0,0">
                    <CheckBox x:Name="PerformanceOverlayEnabledCheck" Content="显示性能悬浮窗" Margin="0,0,0,8"/>
                    <TextBlock Text="显示真实系统 / 进程采样。CPU 按整台电脑的 0–100% 计算；游戏内存是进程工作集，不等于 JVM 堆上限。初次 CPU 采样需要两个采样点。"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="PerformanceOverlaySystemCpuCheck" Content="系统 CPU" Margin="0,0,16,6"/>
                        <CheckBox x:Name="PerformanceOverlaySystemMemoryCheck" Content="系统内存" Margin="0,0,16,6"/>
                        <CheckBox x:Name="PerformanceOverlayMemoryPercentCheck" Content="内存使用百分比" Margin="0,0,16,6"/>
                        <CheckBox x:Name="PerformanceOverlayLauncherCheck" Content="启动器 CPU / 内存" Margin="0,0,16,6"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="PerformanceOverlayGamesCheck" Content="游戏列表" Margin="0,0,16,6"/>
                        <CheckBox x:Name="PerformanceOverlayGameCpuCheck" Content="游戏 CPU" Margin="0,0,16,6"/>
                        <CheckBox x:Name="PerformanceOverlayGameMemoryCheck" Content="游戏内存" Margin="0,0,16,6"/>
                        <CheckBox x:Name="PerformanceOverlayGameTotalsCheck" Content="所选范围的游戏合计" Margin="0,0,16,6"/>
                        <CheckBox x:Name="PerformanceOverlayPidCheck" Content="进程 PID" Margin="0,0,16,6"/>
                    </WrapPanel>
                    <TextBlock Text="GPU / NPU 硬件监视" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,8"/>
                    <WrapPanel>
                        <Border Width="340" Margin="0,0,12,12" Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource PanelBrush}">
                            <StackPanel>
                                <CheckBox x:Name="PerformanceOverlayGpuCheck" Content="显示 GPU · 图形处理器" FontWeight="SemiBold" Margin="0,0,0,12" Checked="PerformanceHardwareToggle_Changed" Unchecked="PerformanceHardwareToggle_Changed"/>
                                <StackPanel x:Name="PerformanceOverlayGpuOptions">
                                    <CheckBox x:Name="PerformanceOverlayGpuUtilizationCheck" Content="显示使用率" Margin="0,0,0,6" Checked="PerformanceHardwareToggle_Changed" Unchecked="PerformanceHardwareToggle_Changed"/>
                                    <ComboBox x:Name="PerformanceOverlayGpuUtilizationFormatCombo" Margin="0,0,0,12" SelectionChanged="PerformanceHardwareChoice_Changed">
