<local:OverlayDialogControl x:Class="XCL2.App.Views.CrashReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        MinWidth="420" MaxWidth="680">
    <!-- 游戏崩溃提示弹窗：跟通用的 MessageBoxDialog 分开单独做一个，是因为该场景
         比普通提示多几个专属动作——"查看完整日志"（跳转到日志页对应标签）、"在记事本中
         查看日志"（把同一份合并日志写到临时文件并用系统记事本打开）和"导出完整日志"
         （把启动器日志+游戏崩溃前输出+游戏日志文件合并成一个文件另存），这几个按钮塞进
         通用 MessageBoxDialog 的按钮方案（OK/OKCancel/YesNo/YesNoCancel）里都不合适，
         硬塞进去只会让那个通用类变得更难维护，所以单独建一个。-->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" MaxWidth="640">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock x:Name="DiagnosticIcon" Text="✖" FontSize="26" FontFamily="Segoe UI Emoji" VerticalAlignment="Top"
                       Margin="0,0,12,0" Foreground="{DynamicResource DangerBrush}"/>
            <TextBlock x:Name="TitleText" Text="游戏崩溃了" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <Border x:Name="OpenGlRepairSection" Visibility="Collapsed" Margin="0,0,0,10"
                BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}" CornerRadius="8" Padding="10">
            <StackPanel>
                <TextBlock Text="OpenGL 驱动修复" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <TextBlock x:Name="OpenGlRepairMessage" TextWrapping="Wrap" MaxHeight="250"/>
                <TextBlock x:Name="OpenGlEvidencePath" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Button Content="一键尝试安装显卡驱动（Windows Update）" Margin="0,10,0,0"
                        Padding="12,8" Click="InstallOpenGlDriver_Click"/>
                <local:DriverDownloadLinks/>
            </StackPanel>
        </Border>
        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
        </ScrollViewer>

        
        <Border x:Name="AnalysisSection" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Margin="0,12,0,0" Padding="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="自动分析" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="AnalysisSourceText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AnalysisText" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Expander x:Name="MoreErrorsExpander" Header="显示更多报错与警告 · 深度日志扫描" Margin="0,14,0,0" Expanded="MoreErrors_Expanded">
            <StackPanel>
                <TextBlock Text="按日志等级列出线索并附修复建议；游戏仍运行时全部作为警告。相同消息会合并。" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MoreErrorsText" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>
            </StackPanel>
        </Expander>
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorCodeText" Text="错误编号：XCL-GAME-EXIT" FontSize="12" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="复制说明" Padding="10,5" Click="CopyExplanation_Click"/>
            <Button x:Name="AnalyzeCrashWithAiButton" Grid.Row="1" Content="AI 分析" Padding="14,8" Margin="0,14,0,0"
                    HorizontalAlignment="Left" ToolTip="提交本次崩溃日志给已配置的 AI 服务分析"
                    Style="{DynamicResource SecondaryButton}" Click="AnalyzeCrashWithAi_Click"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,14,0,0" HorizontalAlignment="Right">
                <Button Content="日志与修复 ▾" Padding="12,8" Margin="0,0,8,0" Click="OpenTools_Click">
                    <Button.ContextMenu><ContextMenu>
                        <MenuItem x:Name="ExportLogButton" Header="预览并导出诊断包…" Click="ExportLog_Click"/>
                        <MenuItem x:Name="OpenInNotepadButton" Header="在记事本查看脱敏日志" Click="OpenInNotepad_Click"/>
                        <Separator/>
                        <MenuItem x:Name="InstallDirectXButton" Header="补全 DirectX 运行库…" Click="InstallDirectX_Click"/>
                    </ContextMenu></Button.ContextMenu>
                </Button>
                <Button Content="关闭" Padding="20,8" IsDefault="True" Style="{DynamicResource PrimaryButton}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</local:OverlayDialogControl>
