<UserControl x:Class="XCL2.App.Views.VersionSelectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:XCL2.App.Services">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 文件夹列表（类似 PCL 左侧） -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="10" Margin="0,0,10,0" Padding="16">
            <!-- 同上：加 ScrollViewer 防止窗口矮的时候"添加已有文件夹"按钮被裁到看不见、点不到。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Ui_Folders}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <ListBox x:Name="FolderListBox" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                             SelectionChanged="FolderListBox_SelectionChanged" MaxHeight="260">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" ToolTip="{Binding Path}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" services:LongPressToolTipBehavior.Enabled="True" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Grid.Column="1" Text="（默认）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" services:LongPressToolTipBehavior.Enabled="True" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- 每个文件夹右侧的设置按钮：点击弹出二级菜单（打开/重命名/设为默认/删除）。
                                         Tag="{Binding}" 把当前行绑定的 GameFolder 传给菜单项，点击时从 Tag 取回。 -->
                                    <Button Grid.Column="1" Content="⚙️" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Tag="{Binding}" Click="FolderSettingsMenu_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开文件夹" Tag="{Binding}" Click="OpenFolder_Click"/>
                                                <MenuItem Header="重命名文件夹..." Tag="{Binding}" Click="RenameFolder_Click"/>
                                                <MenuItem Header="设为默认文件夹" Tag="{Binding}" Click="SetDefaultFolder_Click"/>
                                                <Separator/>
                                                <MenuItem Header="删除文件夹（从列表中移除）" Tag="{Binding}" Click="RemoveFolder_Click"/>
                                                <MenuItem Header="直接删除文件夹（从电脑中删除）" Tag="{Binding}" Click="DeleteFolderFromDisk_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{DynamicResource Str_Ui_Add_Or_Import}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,20,0,8"/>
                    <Button Content="{DynamicResource Str_Ui_Add_Existing_Folder}" Style="{StaticResource SideNavButton}" Click="AddFolder_Click"/>

                    <!-- 导入整合包：跟拖拽安装走同一条 ImportDroppedModpackAsync 流程，
                         这里只是补一个不依赖"拖文件"的入口，方便用户直接点按钮选文件。
                         图标跟"➕ 添加已有文件夹"保持同一套视觉语言，而不是纯文字按钮。 -->
                    <Button Content="📦 导入整合包..." Style="{StaticResource SideNavButton}" Margin="0,6,0,0" Click="ImportModpack_Click"/>

                    <!-- 导入实例/版本文件夹：把一个现成的、已经有 json+jar 的版本文件夹（比如从别的
                         启动器、备份里复制出来的）整个拷进当前选中的 .minecraft 的 versions/ 下，
                         装完之后自动选中，右侧列表里就能直接用⚙️菜单设置/启动，不用再手动找。 -->
                    <Button Content="📁 导入实例文件夹..." Style="{StaticResource SideNavButton}" Margin="0,6,0,0" Click="ImportInstanceFolder_Click"/>

                    <!-- "导入实例文件"：比上面两个正式按钮更零散、次要的入口——用来导入单个打包成
                         .zip 的实例文件（而不是一整个文件夹）。之前用 Hyperlink 做成了默认的
                         系统蓝/访问态红色链接样式，跟整个界面的配色格格不入；改成跟另外两个按钮
                         同一个 SideNavButton 样式 + 📄 图标，只是放在稍微缩进、字号略小的位置，
                         视觉上仍然比上面两个"次要"，但不再突兀。 -->
                    <Button Content="📄 导入实例文件..." Style="{StaticResource SideNavButton}" FontSize="12"
                            Margin="8,8,0,0" Padding="6,3" Opacity="0.75" HorizontalAlignment="Left"
                            Click="ImportInstanceFile_Click"/>

                    <!-- "从列表中删除"的实例入口：当前文件夹下如果有被隐藏的实例，这里显示
                         一个按钮打开恢复列表，跟主列表分开放，避免大多数用户（没有任何隐藏实例）
                         平时也要看到这一块。 -->
                    <Button x:Name="ShowHiddenInstancesBtn" Content="已隐藏的实例..." Style="{StaticResource SideNavButton}"
                            Margin="0,8,0,0" Visibility="Collapsed" Click="ShowHiddenInstances_Click"/>

                    <!-- 未安装完成(缺 jar/继承链不完整)的版本入口，跟上面 ShowHiddenInstancesBtn
                         同一套"默认收起、有内容才出现"的模式，见 VersionSelectPage.xaml.cs
                         RefreshIncompleteVersionsButtonVisibility 注释。 -->
                    <Button x:Name="IncompleteVersionsBtn" Content="未完成的安装..." Style="{StaticResource SideNavButton}"
                            Margin="0,8,0,0" Visibility="Collapsed" Click="IncompleteVersions_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 版本列表 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
            <!-- 版本列表。原来页面下方还有一个"单个版本设置区域"(PerVersionSettingsPanel，
                 选中/右键实例时会占去整页 3/7 变成一整个设置面板)。已去掉：版本设置统一从
                 每个实例右侧的 ⚙️ 按钮二级菜单进入，不占页面空间。 -->
            <Grid>

                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Text="{DynamicResource Str_Ui_Installed_Versions}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1" Content="筛选" Padding="10,6" Margin="0,0,8,0" ToolTip="按名称、备注、标签或收藏筛选实例" Click="ToggleInstanceFilter_Click"/>
                        <Button Grid.Column="2" Content="{DynamicResource Str_Ui_Install_New_Version}" Style="{StaticResource PrimaryButton}"
                                Padding="12,6" Click="InstallNewVersion_Click"/>
                    </Grid>

                    <Grid x:Name="InstanceFilterRow" DockPanel.Dock="Top" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="InstanceFilterBox" MinWidth="80" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 ToolTip="搜索实例名称、版本、标签和备注" AutomationProperties.Name="搜索实例名称、版本、标签和备注" TextChanged="InstanceFilter_Changed"/>
                        <ComboBox x:Name="InstanceScopeBox" Grid.Column="1" MinHeight="32" SelectedIndex="0" ToolTip="显示全部、收藏或最近启动的实例" AutomationProperties.Name="实例筛选范围" SelectionChanged="InstanceFilter_Changed">
                            <ComboBoxItem Content="全部实例"/><ComboBoxItem Content="已收藏"/><ComboBoxItem Content="最近使用"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="清除" Margin="8,0,0,0" Padding="10,5" ToolTip="清除筛选条件" Click="ClearInstanceFilter_Click"/>
                    </Grid>
                    <TextBlock x:Name="InstanceEmptyMessage" DockPanel.Dock="Top" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,12"/>
                    <TextBlock x:Name="BackgroundTaskOwnership" DockPanel.Dock="Top" Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Str_Ui_Installed_On_This_Pc}" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- ListBox 撑满剩余空间，内容比这一行还高时用自己的 ScrollViewer（ListBox 默认自带）单独滚动。 -->
                    <ListBox x:Name="InstalledListBox" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerBrush}"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="InstalledListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ContextMenu>
                                        <!-- 右键菜单：查看 Wiki / 重命名 / 删除。
                                             Tag="{Binding}" 把当前行绑定的 GameVersion 传给菜单项，
                                             点击时从 Tag 里取回对应实例，见 .xaml.cs 里对应处理方法。 -->
                                        <ContextMenu Opened="PluginInstanceMenu_Opened">
                                            <MenuItem Header="{DynamicResource Str_Ui_Open_On_The_Chinese_Minecraft_Wiki}"
                                                      Tag="{Binding}" Click="ViewOnWiki_Click"/>
                                            <Separator/>
                                            <MenuItem Header="重命名..." Tag="{Binding}" Click="RenameInstance_Click"/>
                                            <MenuItem Header="删除..." Tag="{Binding}" Click="DeleteInstance_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center" ToolTip="{Binding FullDisplayToolTip}" services:LongPressToolTipBehavior.Enabled="True">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Width="28" Height="28" Margin="0,0,8,0">
                                            <TextBlock Text="🧊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCustomIcon}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding CustomIconPath}" Stretch="UniformToFill"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="共享游戏目录" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="这个实例与其他实例共用游戏目录，模组和存档可能共用。此标记不会修改隔离设置。">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                                    <DataTrigger Binding="{Binding SharesGameDirectory}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding MetadataSummary}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding MetadataSummary}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="实例文件不完整，需要修复" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 每个实例条目右侧的单独设置入口：点击弹出二级菜单（版本设置/重命名/删除），
                                        不再直接进入设置——版本设置统一从菜单进。
                                        Tag="{Binding}" 把这一行对应的 GameVersion 传给菜单项，
                                        点击时从 Tag 取回对应实例，见 .xaml.cs 里对应处理方法。 -->
                                    <Button Grid.Column="1" Content="⚙️" ToolTip="{DynamicResource Str_Ui_Instance_Settings}"
                                            Padding="8,4" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Tag="{Binding}" Click="OpenInstanceSettingsMenu_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu Opened="PluginInstanceMenu_Opened">
                                                <MenuItem Header="{DynamicResource Str_Ui_Instance_Settings}" Tag="{Binding}" Click="OpenInstanceSettings_Click"/>
                                                <Separator/>
                                                <MenuItem Header="重命名..." Tag="{Binding}" Click="RenameInstance_Click"/>
                                                <MenuItem Header="删除..." Tag="{Binding}" Click="DeleteInstance_Click"/>
                                                <MenuItem Header="补全文件" Tag="{Binding}" Click="RepairInstance_Click">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <ContentControl x:Name="VersionLoadingHost" Visibility="Collapsed"
                                Background="{DynamicResource PanelBrush}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
