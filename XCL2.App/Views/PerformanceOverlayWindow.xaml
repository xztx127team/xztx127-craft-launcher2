<Window x:Class="XCL2.App.Views.PerformanceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="性能悬浮窗" WindowStyle="None" ResizeMode="NoResize"
        SizeToContent="Height" Width="320" MinHeight="54" MaxHeight="540"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False">
    <Border x:Name="OverlayCard" CornerRadius="9" BorderThickness="1" Padding="12,9"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
            MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
            ContextMenuOpening="Overlay_ContextMenuOpening"
            ToolTip="左键拖动位置，右键修改样式、显示实例与详细设置">
        <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="510">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="性能 · 右键设置" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBlock x:Name="SystemText" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="LauncherText" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="GameTotalsText" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>
                <StackPanel x:Name="GamesPanel" Margin="0,6,0,0"/>
                <TextBlock x:Name="StatusText" Text="正在读取性能数据…" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
