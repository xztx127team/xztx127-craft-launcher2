<UserControl x:Class="XCL2.App.Views.AiAssistantPanel"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:views="clr-namespace:XCL2.App.Views"
              xmlns:services="clr-namespace:XCL2.App.Services"
              mc:Ignorable="d"
              d:DesignWidth="1040" d:DesignHeight="650"
              Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="ActivityTextStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MaxHeight" Value="180"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="ActivityCodeStyle" TargetType="TextBox" BasedOn="{StaticResource ActivityTextStyle}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </UserControl.Resources>
    <Grid services:ScrollWheelBehavior.ContainWheel="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 背景层单独承载"抽屉"独立透明度/磨砂：不直接把 Effect 挂在 UserControl 根节点上，
             否则连带把下面聊天文字/输入框一起糊掉。跟 OverlayCard 的 OverlayCardBackgroundLayer
             是同一个思路（见 MainWindow.xaml 注释），这里额外横跨两行铺满整个面板。 -->
        <Border x:Name="DrawerBackgroundLayer" Grid.Row="0" Grid.RowSpan="2"
                Background="{DynamicResource DrawerBackgroundBrush}" Effect="{DynamicResource DrawerBlurEffect}"/>

        <!-- 顶栏：模型/设置仍在聊天区上方，历史改成左侧常驻，不再用浮层遮住消息。 -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="13,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="11" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F8CFF" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="0.58"/>
                                <GradientStop Color="#22C7E8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconAI}" Width="21" Height="21" Stretch="Uniform"
                              Stroke="White" StrokeThickness="1.7" Fill="Transparent"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="XCL 智能助手" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="RouteStatusText" Text="自动路由 · 准备就绪" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" ToolTip="AI 设置 / 默认模型" Width="32" Height="32" Margin="0,0,3,0"
                            Click="SettingsButton_Click" Style="{DynamicResource IconButtonStyle}">
                        <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconSettings}"/>
                    </Button>
                    <Button x:Name="CloseButton" ToolTip="收起" Width="32" Height="32"
                            Click="CloseButton_Click" Style="{DynamicResource IconButtonStyle}">
                        <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconClose}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="178"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="228"/>
            </Grid.ColumnDefinitions>

            <!-- ChatGPT 风格的左侧会话历史。 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" Padding="9,10,8,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="NewChatButton" Grid.Row="0" Height="36" HorizontalContentAlignment="Left"
                            Click="NewChatButton_Click" IsEnabled="True" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Margin="0,0,8,0"/>
                            <TextBlock Text="新对话" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Row="1" Text="对话历史" FontSize="10" Margin="5,13,4,6"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ListBox x:Name="HistoryListBox" Grid.Row="2" BorderThickness="0" Background="Transparent"
                             SelectionChanged="HistoryListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7,7,4,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}"/>
                                        <TextBlock Text="{Binding UpdatedText}" FontSize="9" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Width="23" Height="23" Margin="2,0,0,0" Padding="0"
                                            ToolTip="重命名" Click="RenameSession_Click" Tag="{Binding Session}"
                                            Style="{DynamicResource IconButtonStyle}">
                                        <TextBlock Text="✎" FontSize="11"/>
                                    </Button>
                                    <Button Grid.Column="2" Width="23" Height="23" Margin="1,0,0,0" Padding="0"
                                            ToolTip="删除对话" Click="DeleteSession_Click" Tag="{Binding Session}"
                                            Style="{DynamicResource IconButtonStyle}">
                                        <TextBlock Text="×" FontSize="15"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="历史仅保存在本机" FontSize="9" Margin="5,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource DividerBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 路由 / 模型仍固定在最上面。自动、普通、专家模式下模型由设置决定，不能在这里误改。 -->
                <Border Grid.Row="0" Margin="10,10,10,4" Padding="10" CornerRadius="12"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型路由" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="RoutingModeCombo" Grid.Column="1" Height="30" FontSize="11"
                                      SelectionChanged="RoutingModeCombo_SelectionChanged">
                                <ComboBoxItem Content="自动 · 按问题智能切换" Tag="Auto"/>
                                <ComboBoxItem Content="普通 · 功能入口 / 使用说明" Tag="Normal"/>
                                <ComboBoxItem Content="专家 · 日志 / 故障排查" Tag="Expert"/>
                                <ComboBoxItem Content="指定模型 · 手动选择" Tag="SpecificModel"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <ComboBox x:Name="ModelCombo" Height="30" FontSize="11"
                                          SelectedValuePath="ModelKey" SelectionChanged="ModelCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock><Run Text="{Binding ProviderName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DisplayName, Mode=OneWay}"/></TextBlock></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Border x:Name="ResolvedModelBorder" CornerRadius="6" Background="{DynamicResource SideBrush}"
                                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Padding="9,6">
                                    <TextBlock x:Name="ResolvedModelText" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </Grid>
                        <Border x:Name="TaskSelectionBar" Margin="0,8,0,0" Padding="8,6" CornerRadius="6"
                                Background="{DynamicResource SideBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="当前任务" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox x:Name="TaskSelectionCombo" Grid.Column="1" Height="30" FontSize="11"
                                          DisplayMemberPath="Label" SelectedValuePath="Id"
                                          DropDownOpened="TaskSelectionCombo_DropDownOpened"
                                          SelectionChanged="TaskSelectionCombo_SelectionChanged"
                                          ToolTip="这里只显示未完成的任务；已完成任务可从右侧入口查看或删除。运行中的任务会打开原会话。"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="已完成" Padding="8,3" Margin="6,0,0,0"
                                            FontSize="10" Click="CompletedTasksButton_Click"/>
                                    <Button Content="刷新" Padding="8,3" Margin="6,0,0,0"
                                            FontSize="10" Click="RefreshTasksButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="RoutingHintText" Margin="0,7,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="自动模式会按问题类型使用设置里的普通/专家默认模型。"/>
                        <TextBlock x:Name="ChatSpecialTermsNoticeText" Margin="0,6,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningTextBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="11,4,11,8">
                    <ItemsControl x:Name="MessagesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,5" Padding="12,9" CornerRadius="12"
                                        HorizontalAlignment="{Binding BubbleAlignment}" MaxWidth="620"
                                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                        Background="{Binding BubbleBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                                            <views:AiGenerationIndicator Width="32" Height="8" Margin="0,0,9,0"/>
                                            <TextBlock Text="正在生成…" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,5" Margin="0,0,0,4" CornerRadius="6"
                                                            Background="{DynamicResource SideBrush}">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Name}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Expander Header="思考过程" IsExpanded="False" Visibility="{Binding ReasoningVisibility}" Margin="0,0,0,8">
                                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                                <StackPanel><TextBlock Text="{Binding ThinkingStatusText}" TextWrapping="Wrap" FontSize="11"/>
                                                <ItemsControl ItemsSource="{Binding ReasoningActivities}">
                                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="4,6">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <views:AiGenerationIndicator Height="8" Margin="0,4" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBox Text="{Binding Details, Mode=OneWay}" Style="{StaticResource ActivityTextStyle}"/>
                                                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl></StackPanel>
                                            </ScrollViewer>
                                        </Expander>
                                        <Expander Header="{Binding ActivitiesHeader}" IsExpanded="True"
                                                  Visibility="{Binding ActivitiesVisibility}" Margin="0,0,0,8">
                                            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled" Margin="0,7,0,0">
                                                <ItemsControl ItemsSource="{Binding VisibleActivities}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="9,7" Margin="0,0,0,6" CornerRadius="8"
                                                                    Background="{DynamicResource SideBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                                                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                                                                    <Expander.Header>
                                                                        <StackPanel>
                                                                            <WrapPanel>
                                                                                <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                                                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                            </WrapPanel>
                                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/>
                                                                        </StackPanel>
                                                                    </Expander.Header>
                                                                    <StackPanel Margin="0,7,0,0">
                                                                        <views:AiGenerationIndicator Height="8" Margin="0,0,0,6" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBox Text="{Binding ModelLabel, Mode=OneWay}" Style="{StaticResource ActivityTextStyle}"
                                                                                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"
                                                                                 Visibility="{Binding HasModel, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBox Text="{Binding FilePath, Mode=OneWay}" Style="{StaticResource ActivityTextStyle}"
                                                                                 FontFamily="Consolas" Margin="0,0,0,5"
                                                                                 Visibility="{Binding HasFilePath, Converter={StaticResource BoolToVis}}"/>
                                                                        <views:AiFileDiffView Visibility="{Binding HasFileDiff, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0"/>
                                                                        <TextBox Text="{Binding Command, Mode=OneWay}" Style="{StaticResource ActivityCodeStyle}"
                                                                                 Margin="0,0,0,6"
                                                                                 Visibility="{Binding HasCommand, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBox Text="{Binding Details, Mode=OneWay}" Style="{StaticResource ActivityTextStyle}"
                                                                                 Margin="0,0,0,5"
                                                                                 Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"/>
                                                                        <StackPanel Visibility="{Binding HasBeforeCode, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                                                            <TextBlock Text="{Binding BeforeLabel}" FontSize="10" Margin="0,0,0,4"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                            <TextBox Text="{Binding BeforeCode, Mode=OneWay}" Style="{StaticResource ActivityCodeStyle}"/>
                                                                        </StackPanel>
                                                                        <StackPanel Visibility="{Binding HasAfterCode, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                                                            <TextBlock Text="{Binding AfterLabel}" FontSize="10" Margin="0,0,0,4"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                            <TextBox Text="{Binding AfterCode, Mode=OneWay}" Style="{StaticResource ActivityCodeStyle}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Expander>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Expander>
                                        <TextBlock Text="{Binding ReasoningAvailabilityHint}" TextWrapping="Wrap" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                                   Visibility="{Binding ReasoningAvailabilityVisibility}"/>
                                        <Grid Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}">
                                            <TextBox Text="{Binding DisplayContent}" TextWrapping="Wrap" FontSize="13"
                                                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                     IsTabStop="False" AcceptsReturn="True"
                                                     Visibility="{Binding IsUserMessage, Converter={StaticResource BoolToVis}}"/>
                                            <views:MarkdownViewer Markdown="{Binding DisplayContent}"
                                                                  Visibility="{Binding IsAssistantMessage, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>

                                        <!-- “修复”编辑态：把气泡内容换成可编辑输入框 + 分支提示条，仅用户消息可进入。 -->
                                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                            <TextBox x:Name="EditBox" Text="{Binding EditingText, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap" FontSize="13" AcceptsReturn="True"
                                                     MinHeight="42" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                                     Padding="8,6"
                                                     Background="{DynamicResource PanelBrush}"
                                                     BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.3"/>
                                            <Border Margin="0,7,0,0" Padding="9,7" CornerRadius="9"
                                                    Background="{DynamicResource SideBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="15" Height="15" CornerRadius="8" Background="{DynamicResource AccentBrush}"
                                                                VerticalAlignment="Top" Margin="0,1,6,0">
                                                            <TextBlock Text="i" FontSize="10" FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="保存修改会基于这条消息创建一个新的对话分支，原有回复不会被覆盖。"
                                                                   FontSize="10.5" TextWrapping="Wrap" MaxWidth="440"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                        <Button Content="取消" FontSize="10.5" Padding="12,4" Margin="0,0,6,0"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="CancelEditMessage_Click" Tag="{Binding}"/>
                                                        <Button Content="保存" FontSize="10.5" Padding="12,4"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Click="SaveEditMessage_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SubLabel}" FontSize="9" Margin="0,5,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding SubLabelVisibility}"/>
                                        <StackPanel x:Name="ActionBar" Orientation="Horizontal" Margin="0,7,0,0"
                                                    Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right">
                                            <Button Content="复制" FontSize="10" Padding="8,3" Margin="0,0,4,0"
                                                    Click="CopyMessage_Click" Tag="{Binding}"/>
                                            <Button Content="撤回" FontSize="10" Padding="8,3" Margin="0,0,4,0"
                                                    Click="UndoMessage_Click" Tag="{Binding}"
                                                    Visibility="{Binding IsUserMessage, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="修复" FontSize="10" Padding="8,3" Margin="0,0,4,0"
                                                    Click="FixMessage_Click" Tag="{Binding}"
                                                    Visibility="{Binding IsUserMessage, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="重新生成" FontSize="10" Padding="8,3"
                                                    Click="RegenerateMessage_Click" Tag="{Binding}"
                                                    Visibility="{Binding IsAssistantMessage, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard><Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionBar" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard></BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard><Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ActionBar" Storyboard.TargetProperty="Visibility">
                                                    <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard></BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 输入区 + AI 提问卡片放在同一个格子里：模型发起 XCL2_ASK 时卡片显示并覆盖输入框 -->
                <Grid Grid.Row="2">
                <Border x:Name="InputArea" Margin="10,4,10,10" Padding="9" CornerRadius="13"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="工作模式" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="WorkModeCombo" FontSize="10" MinWidth="112" Height="28" Margin="0,0,10,0"
                                          ToolTip="纯聊天仅用于对话；Plan 只读调查并制定计划；Build 按已有权限执行；Agent 复杂任务建议保存计划，简单需求可直接处理。"
                                          SelectionChanged="WorkModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Build · 执行" Tag="Build"/>
                                    <ComboBoxItem Content="Plan · 规划" Tag="Plan"/>
                                    <ComboBoxItem Content="Agent · 智能执行" Tag="Agent"/>
                                    <ComboBoxItem Content="纯聊天模式" Tag="Chat"/>
                                </ComboBox>
                                <TextBlock Text="推理" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="ReasoningLevelCombo" FontSize="10" MinWidth="124" Height="28" Margin="0,0,6,0"
                                          ToolTip="请求接口使用所选推理等级；接口不支持时自动使用无推理模式并以气泡提示。极速仅对已确认支持的模型开放。"
                                          SelectionChanged="ReasoningLevelCombo_SelectionChanged">
                                    <ComboBoxItem Content="off · 关闭" Tag="Off"/>
                                    <ComboBoxItem Content="low · 低" Tag="Low"/>
                                    <ComboBoxItem Content="中" Tag="Medium"/>
                                    <ComboBoxItem Content="高" Tag="High"/>
                                    <ComboBoxItem Content="极高" Tag="VeryHigh"/>
                                    <ComboBoxItem Content="最高（超高）" Tag="Max"/>
                                    <ComboBoxItem x:Name="FastReasoningOption" Content="极速" Tag="Fast" Visibility="Collapsed" IsEnabled="False"/>
                                </ComboBox>
                                <ToggleButton x:Name="WebSearchCheck" Content="联网搜索" FontSize="10" Padding="9,4"
                                              Style="{StaticResource GuestModeToggleStyle}" Click="QuickOption_Click"/>
                                <Button x:Name="UploadAttachmentButton" Content="上传文件" FontSize="10" Padding="9,4" Margin="6,0,0,0"
                                        Click="UploadAttachment_Click" ToolTip="支持图片和文件；图片分析需要当前模型支持视觉。ZIP 会安全解压到临时只读目录，上传不会授予命令权限。"/>
                            </WrapPanel>

                        </Grid>
                        <Expander Header="任务步骤与断点" Margin="0,0,0,8">
                            <StackPanel>
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="TaskSummaryText" TextWrapping="Wrap" FontSize="11" Margin="6"/></ScrollViewer>
                                <WrapPanel>
                                    <Button x:Name="TaskTrackingButton" Content="设为非任务" Click="TaskTrackingButton_Click" Padding="10,5" Margin="0,4,8,0"
                                            ToolTip="设为非任务后普通聊天不自动创建任务；已有任务记录和变更历史会保留。生成期间不能更改。"/>
                                    <Button x:Name="ResumeTaskButton" Content="跨会话续做" Click="ResumeTaskButton_Click" Padding="10,5" Margin="0,4,8,0"/>
                                    <Button Content="已完成任务" Click="CompletedTasksButton_Click" Padding="10,5" Margin="0,4,8,0"/>
                                    <Button x:Name="ChangeHistoryButton" Content="变更历史 / 一键回滚" Click="ChangeHistoryButton_Click" Padding="10,5" Margin="0,4,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="WorkModeHintText" Margin="0,0,0,7" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Build：按已有权限执行任务。已有计划可发送“按计划继续”开始执行。"/>
                        <ItemsControl x:Name="PendingAttachmentsItemsControl" Margin="0,0,0,5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="7"
                                            Background="{DynamicResource SideBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Summary}" FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="×" Width="24" Height="24" Padding="0" Margin="6,0,0,0"
                                                    Click="RemoveAttachment_Click" CommandParameter="{Binding}" ToolTip="移除附件"
                                                    Style="{DynamicResource IconButtonStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="InputTextBox" Grid.Column="0" MinHeight="42" MaxHeight="120"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Padding="11,9" PreviewKeyDown="InputTextBox_KeyDown" Text=""
                                     ToolTip="Enter 发送；Shift+Enter 换行"/>
                            <Button x:Name="StopButton" Grid.Column="1" Width="42" Height="42" Margin="7,0,0,0"
                                    Click="StopButton_Click" ToolTip="停止生成" Visibility="Collapsed"
                                    Background="{DynamicResource DangerBrush}" Foreground="White" BorderBrush="{DynamicResource DangerBrush}">
                                <TextBlock Text="■" Foreground="White" FontSize="13"/>
                            </Button>
                            <Button x:Name="SendButton" Grid.Column="2" Width="42" Height="42" Margin="7,0,0,0"
                                    Click="SendButton_Click" Style="{DynamicResource IconButtonStyle}" ToolTip="发送 (Enter)">
                                <Path Style="{StaticResource NavIconPath}" Data="{StaticResource IconSend}" Width="17" Height="17"/>
                            </Button>
                            <Button x:Name="UsageIndicatorButton" Grid.Column="3" Width="34" Height="42" Margin="5,0,0,0" Padding="0"
                                    Style="{DynamicResource IconButtonStyle}" Click="UsageIndicatorButton_Click"
                                    MouseEnter="UsageIndicator_MouseEnter" MouseLeave="UsageIndicator_MouseLeave"
                                    PreviewKeyDown="UsageIndicator_PreviewKeyDown"
                                    AutomationProperties.Name="上下文占用及 Token 用量详情">
                                <Viewbox Width="30" Height="30">
                                    <Grid Width="40" Height="40">
                                        <Ellipse Margin="3" Stroke="{DynamicResource BorderBrush2}" StrokeThickness="3"/>
                                        <Path x:Name="UsageRemainingRing" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <TextBlock x:Name="UsageRingLabel" Text="—" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Viewbox>
                            </Button>
                            <Popup x:Name="UsagePopup" PlacementTarget="{Binding ElementName=UsageIndicatorButton}"
                                   Placement="Top" VerticalOffset="-6" AllowsTransparency="True" StaysOpen="True"
                                   Closed="UsagePopup_Closed">
                                <Border x:Name="UsagePopupContent" Width="340" Padding="13" CornerRadius="10"
                                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                                        MouseEnter="UsagePopup_MouseEnter" MouseLeave="UsageIndicator_MouseLeave"
                                        PreviewKeyDown="UsageIndicator_PreviewKeyDown">
                                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock x:Name="TokenUsageText" Text="本对话 · 暂无用量" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UsageSummaryText" FontSize="10" Margin="0,4,0,6"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="ContextUsageText" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="CacheUsageText" Text="当前缓存命中率：暂无数据" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="CostUsageText" Text="本对话估计成本：未配置单价" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TotalUsageText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="QuotaUsageText" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="UsageSourceText" Margin="0,7,0,0" FontSize="9" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button Content="设置限额 / 单价" Click="UsageSettingsButton_Click"
                                                HorizontalAlignment="Left" Padding="8,4" Margin="0,9,0,0" FontSize="10"/>
                                        <TextBlock Text="点击圆圈固定详情；Esc 或点击外部关闭。" FontSize="9" Margin="0,7,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <Grid Margin="2,5,2,0">
                            <TextBlock Text="Enter 发送 · Shift+Enter 换行" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="NoKeyHint" Text="尚无可用模型，请在右上角设置中启用接口并拉取或添加模型" FontSize="9"
                                       Foreground="{DynamicResource WarningTextBrush}" HorizontalAlignment="Right" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="LongWaitHintText" Margin="2,7,2,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                        <TextBlock Margin="2,5,2,0" FontSize="9" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="AI 可能会犯错，也都有知识截止日期。若它声称某个 MC / 模组版本‘不是正式版而是快照版’，请不要直接相信；版本状态请以官方发布页、Modrinth 或 CurseForge 为准。"/>
                    </StackPanel>
                </Border>
                <views:AiQuestionCard x:Name="QuestionCard" Margin="10,4,10,10" VerticalAlignment="Stretch"
                                      Visibility="Collapsed"/>
                </Grid>
            </Grid>
            <Border Grid.Column="3" Background="{DynamicResource DividerBrush}"/>
            <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" Padding="12,13,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Plan" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PlanSummaryText" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="任务计划"/>
                        <TextBlock Text="○ 正在进行   ✓ 已完成   – 未开始" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,11,0,9"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="PlanEmptyText" FontSize="11" TextWrapping="Wrap" Margin="1,4,1,8"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="复杂任务建议保存计划，步骤进度显示在这里；简单需求可直接处理。"/>
                            <ItemsControl x:Name="PlanStepsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SideBrush}" CornerRadius="9" Padding="9,9" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="17"
                                                           Foreground="{DynamicResource AccentBrush}" ToolTip="{Binding StatusLabel}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="9" Margin="0,4,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Evidence}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Visibility="{Binding EvidenceVisibility}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border x:Name="PlanNextActionBorder" Grid.Row="3" Padding="9" Margin="0,9,0,0" CornerRadius="8"
                            Background="{DynamicResource SideBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="下一步" FontSize="10" FontWeight="SemiBold"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="PlanNextActionText" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
