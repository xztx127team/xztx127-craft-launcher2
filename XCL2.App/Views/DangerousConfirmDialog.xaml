<local:OverlayDialogControl x:Class="XCL2.App.Views.DangerousConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XCL2.App.Views"
        Width="420">
    
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                   Foreground="{DynamicResource WarningTextBrush}"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,14"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock x:Name="ConfirmCodeHintText" Text="请输入确认码 xztx127 以继续：" Margin="0,0,0,6"/>
        <TextBox x:Name="ConfirmCodeBox" Height="30" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="ErrorText" Foreground="IndianRed" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="HoldHint" Text="已启用按住确认：输入确认码后按住按钮 1.2 秒，也可聚焦按钮后按住空格键。" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelBtn" Content="{DynamicResource Str_Common_Cancel}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="确认执行" MinWidth="118" Padding="8,4" Style="{DynamicResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</local:OverlayDialogControl>
