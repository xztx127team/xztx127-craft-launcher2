<local:OverlayDialogControl x:Class="XCL2.App.Views.InstalledVersionComponentsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:XCL2.App.Views"
    MinWidth="440" MaxWidth="620" MaxHeight="720">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="版本与组件" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="InstanceTitle" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border CornerRadius="10" Padding="14" Margin="0,0,0,16" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="当前安装" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentDescription" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="ComponentList" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Version}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="管理" Tag="{Binding}" Padding="10,5" Margin="10,0,0,0" Click="ManageComponent_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="可更换 Minecraft 版本，添加、更新或移除加载器。实例名称、存档、模组与配置保留。"
                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Button x:Name="BackupFolderButton" Content="查看备份" IsEnabled="False" HorizontalAlignment="Left"
                        Padding="10,5" Margin="0,0,0,12" ToolTip="打开完整实例备份所在的文件夹" Click="OpenBackupFolder_Click"/>
                <TextBlock x:Name="CompositeNotice" Visibility="Collapsed" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="检测到组合或扩展启动组件。本窗口会整体替换这组启动组件，不支持在此逐个拆分混装配置。以 Mod 形式安装的组件由 Mod 管理单独维护。"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <CheckBox x:Name="ReplaceCompositeCheck" Visibility="Collapsed" Margin="0,0,0,14" Click="ReplaceComposite_Click">
                    <TextBlock Text="我确认将上方列出的全部启动组件替换为下面选择的组件（以 Mod 形式安装的组件不受影响）" TextWrapping="Wrap"/>
                </CheckBox>
                <StackPanel x:Name="SelectionPanel">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Minecraft 版本" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新列表" Padding="10,5" Click="Refresh_Click"/>
                    </Grid>
                    <ComboBox x:Name="MinecraftCombo" MinHeight="36" Style="{DynamicResource FilterComboBox}" SelectionChanged="Selection_Changed"/>
                    <CheckBox x:Name="IncludeSnapshots" Content="显示快照与测试版" Margin="0,8,0,16" Click="IncludeSnapshots_Click"/>
                    <TextBlock Text="加载器 / 客户端组件" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="LoaderCombo" MinHeight="36" Style="{DynamicResource FilterComboBox}" SelectionChanged="Selection_Changed">
                        <ComboBoxItem Content="原版（不安装加载器）" Tag="Vanilla"/>
                        <ComboBoxItem Content="Fabric" Tag="Fabric"/>
                        <ComboBoxItem Content="Legacy Fabric" Tag="LegacyFabric"/>
                        <ComboBoxItem Content="Forge" Tag="Forge"/>
                        <ComboBoxItem Content="NeoForge" Tag="NeoForge"/>
                        <ComboBoxItem Content="Quilt" Tag="Quilt"/>
                        <ComboBoxItem Content="OptiFine" Tag="OptiFine"/>
                    </ComboBox>
                    <StackPanel x:Name="BuildPanel" Margin="0,12,0,0">
                        <TextBlock Text="组件版本" Margin="0,0,0,8"/>
                        <ComboBox x:Name="BuildCombo" MinHeight="36" Style="{DynamicResource FilterComboBox}"
                                  DisplayMemberPath="DisplayVersion" SelectionChanged="Build_Changed"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="LatestButton" Content="使用推荐版本" Padding="10,5" Margin="0,0,8,4" Click="Latest_Click"/>
                            <Button x:Name="RemoveLoaderButton" Content="移除加载器" Padding="10,5" Margin="0,0,0,4" Click="RemoveLoader_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="JavaPanel" Margin="0,12,0,0">
                        <TextBlock Text="安装所用 Java（OptiFine 需要 JDK）" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="JavaPathBox" MinHeight="36" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="10,5" Click="BrowseJava_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border Padding="12" CornerRadius="8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="本次修改" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ChangeSummary" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="额外的 profile 字段与自定义启动参数保留；原加载器的引导参数随组件替换。Fabric API、QSL 和放在 mods 目录的 OptiFine 请点“管理模组”。"
                                   Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="应用前会自动备份。更换游戏版本或加载器后，已有模组可能需要在 Mod 管理中更新。请先验证再打开原存档。"
                                   Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <ProgressBar x:Name="OperationProgress" Height="6" Minimum="0" Maximum="1" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ModsButton" Content="管理模组" HorizontalAlignment="Left" Padding="12,8" Click="ManageMods_Click"/>
            <Button x:Name="CloseButton" Grid.Column="1" Content="关闭" Margin="8,0" Padding="14,8" Click="Close_Click"/>
            <Button x:Name="ApplyButton" Grid.Column="2" Content="应用修改" Padding="18,8" IsEnabled="False"
                    Style="{DynamicResource PrimaryButton}" Click="Apply_Click"/>
        </Grid>
    </Grid>
</local:OverlayDialogControl>
