<local:OverlayDialogControl x:Class="XCL2.App.Views.InstallClientLoaderWindow"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:XCL2.App.Views"
                            xmlns:services="clr-namespace:XCL2.App.Services"
                            MinWidth="520"
                            MaxWidth="520"
                            MinHeight="560"
                            MaxHeight="560">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" services:ScrollWheelBehavior.EnableFastWheel="True" Padding="28,24">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str_Ui_Install_New_Version_2}" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Str_Ui_Install_Vanilla_Or_The_Fabric_Forge_Neof}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,18" TextWrapping="Wrap"/>

            <TextBlock Text="{DynamicResource Str_Ui_Loader}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            
            <WrapPanel Margin="0,0,0,14">
                <RadioButton x:Name="LoaderVanilla" Style="{StaticResource DownloadCategoryButton}" IsChecked="True"
                             Content="{DynamicResource Str_Ui_Vanilla_3}" Checked="LoaderType_Checked" Tag="Vanilla" Margin="0,0,6,6"/>
                <RadioButton x:Name="LoaderFabric" Style="{StaticResource DownloadCategoryButton}"
                             Content="Fabric" Checked="LoaderType_Checked" Tag="Fabric" Margin="0,0,6,6"/>
                <RadioButton x:Name="LoaderLegacyFabric" Style="{StaticResource DownloadCategoryButton}"
                             Content="Legacy Fabric" Checked="LoaderType_Checked" Tag="LegacyFabric" Margin="0,0,6,6"/>
                <RadioButton x:Name="LoaderForge" Style="{StaticResource DownloadCategoryButton}"
                             Content="Forge" Checked="LoaderType_Checked" Tag="Forge" Margin="0,0,6,6"/>
                <RadioButton x:Name="LoaderNeoForge" Style="{StaticResource DownloadCategoryButton}"
                             Content="NeoForge" Checked="LoaderType_Checked" Tag="NeoForge" Margin="0,0,6,6"/>
                <RadioButton x:Name="LoaderQuilt" Style="{StaticResource DownloadCategoryButton}"
                             Content="Quilt" Checked="LoaderType_Checked" Tag="Quilt" Margin="0,0,6,6"/>
                <RadioButton x:Name="LoaderOptiFine" Style="{StaticResource DownloadCategoryButton}"
                             Content="OptiFine" Checked="LoaderType_Checked" Tag="OptiFine" Margin="0,0,6,6"/>
            </WrapPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str_Ui_Minecraft_Version}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="McVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"
                              SelectionChanged="McVersionCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" x:Name="BuildVersionPanel">
                    <TextBlock x:Name="BuildVersionLabel" Text="{DynamicResource Str_Ui_Loader_Version}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="BuildVersionCombo" Style="{StaticResource FilterComboBox}" Height="34"
                              SelectionChanged="BuildVersionCombo_SelectionChanged"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="BuildVersionHintText" FontSize="11" Margin="0,-10,0,14" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>

            <!-- NeoForge 没有独立的 MC 版本列表，选中项本身就是完整版本号，不需要第二级下拉框 -->

            
            <TextBlock Text="{DynamicResource Str_Ui_Instance_Name}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="InstanceNameBox" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,0,4"
                     TextChanged="InstanceNameBox_TextChanged"/>
            <TextBlock x:Name="InstanceNameHintText" FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <StackPanel x:Name="JavaPathPanel">
                <TextBlock Text="{DynamicResource Str_Ui_Java_Path}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="JavaPathBox" Grid.Column="0" Style="{StaticResource SearchTextBox}" Height="34" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="{DynamicResource Str_Ui_Auto_Detect}" Style="{StaticResource PrimaryButton}" Click="AutoDetectJava_Click"/>
                </Grid>
            </StackPanel>
            <TextBlock x:Name="JavaRequirementHintText" FontSize="12" Margin="0,-10,0,14" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
            <TextBlock x:Name="FabricNoJavaHintText" FontSize="11" Margin="0,-10,0,14" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"
                       Text="{DynamicResource Str_Ui_Installing_The_Fabric_Client_Doesn_T_Run}"/>

            <CheckBox x:Name="InstallFabricApiCheck" Content="{DynamicResource Str_Ui_Also_Install_Fabric_Api_Many_Fabric_Mods}"
                      IsChecked="True" Margin="0,-6,0,14" Visibility="Collapsed"/>

            <CheckBox x:Name="InstallQslCheck" Content="{DynamicResource Str_Ui_Also_Install_Qsl_Quilt_Standard_Librarie}"
                      IsChecked="True" Margin="0,-6,0,14" Visibility="Collapsed"/>

            <!-- 进度展示 -->
            <StackPanel x:Name="ProgressPanel" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="ProgressStageText" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="ProgressDetailText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <ProgressBar x:Name="ProgressBarCtl" Height="8" Minimum="0" Maximum="1"/>
            </StackPanel>

            <Button x:Name="InstallBtn" Content="{DynamicResource Str_Common_Install}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Padding="0,12" Click="Install_Click"/>
        </StackPanel>
    </ScrollViewer>
</local:OverlayDialogControl>
