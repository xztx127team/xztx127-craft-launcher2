<UserControl x:Class="XCL2.App.Views.AiFloatingButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="48" Background="Transparent">
    <!--
        右下角常驻悬浮球入口。放在 MainWindow 最外层 Grid 的右下角（用 Margin 定位，
        不参与正常布局流），点击后请求宿主窗口打开/切换侧边栏面板。
        角标（Badge）用于提示"有未读的助手回复/压缩提示"之类的轻量通知，默认隐藏。
    -->
    <Grid>
        <Button x:Name="MainButton" Width="48" Height="48" Click="MainButton_Click"
                ToolTip="点击打开 AI助手聊天；右键选择模型、调整悬浮球外观和显示方式，或关闭入口。"
                ToolTipService.ShowDuration="12000" AutomationProperties.Name="AI助手" Cursor="Hand">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Circle">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#3B82F6"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Viewbox Width="36" Height="21" Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="AI" FontWeight="SemiBold" FontSize="15" Foreground="White"
                                       TextWrapping="NoWrap"/>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Ellipse x:Name="Badge" Width="10" Height="10" Fill="#FF4D4F"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                  Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
