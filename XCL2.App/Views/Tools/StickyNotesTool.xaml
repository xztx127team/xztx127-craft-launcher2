<UserControl x:Class="XCL2.App.Views.Tools.StickyNotesTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="StickyNotesTool_Unloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：便签列表 -->
        <Border Grid.Column="0" Background="{DynamicResource SideBrush}" CornerRadius="6" Padding="6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,2,2,8">
                    <Button Content="＋ 新建便签" Padding="10,5" FontSize="12" Click="NoteNew_Click"/>
                    <Button Content="🗑 删除" Padding="10,5" FontSize="12" Margin="8,0,0,0" Click="NoteDelete_Click"/>
                </StackPanel>
                <ListBox x:Name="NoteList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="NoteList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                <TextBlock Text="{Binding TimeText}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧：编辑区 -->
        <StackPanel Grid.Column="2" MaxWidth="640" HorizontalAlignment="Left">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="NotePinBtn" Content="📌 作为桌面便签打开" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="NotePin_Click"/>
                <Button Content="📂 打开便签文件夹" Padding="12,6" Margin="8,0,0,0" Click="NoteOpenFolder_Click"/>
                <TextBlock Text="便签样式" Margin="14,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="NoteStyleCombo" Width="150" SelectionChanged="NoteStyleCombo_SelectionChanged" ToolTip="样式会跟随当前便签保存，下次打开仍会保留">
                    <ComboBoxItem Content="经典黄纸" Tag="Yellow"/>
                    <ComboBoxItem Content="天空蓝" Tag="Blue"/>
                    <ComboBoxItem Content="薄荷绿" Tag="Mint"/>
                    <ComboBoxItem Content="樱花粉" Tag="Pink"/>
                    <ComboBoxItem Content="紫晶" Tag="Purple"/>
                    <ComboBoxItem Content="纸白" Tag="Paper"/>
                    <ComboBoxItem Content="深夜" Tag="Midnight"/>
                    <ComboBoxItem Content="蜜桃" Tag="Peach"/>
                    <ComboBoxItem Content="海洋" Tag="Ocean"/>
                    <ComboBoxItem Content="鼠尾草" Tag="Sage"/>
                    <ComboBoxItem Content="牛皮纸" Tag="Sand"/>
                    <ComboBoxItem Content="石墨" Tag="Graphite"/>
                    <ComboBoxItem Content="终端绿字" Tag="Terminal"/>
                    <ComboBoxItem Content="横线笔记纸" Tag="Notebook"/>
                </ComboBox>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,10">
                <CheckBox x:Name="NoteAlignTopLeftCheck" Content="文字靠左上角显示" IsChecked="True"
                          Checked="NoteLayout_Changed" Unchecked="NoteLayout_Changed" Margin="0,0,18,0"/>
                <CheckBox x:Name="NoteSizeToTextCheck" Content="桌面便签根据文字调整大小" IsChecked="False"
                          ToolTip="默认关闭。自动调整宽高，最多扩展到屏幕可用区域；较长内容可以滚动查看。"
                          Checked="NoteLayout_Changed" Unchecked="NoteLayout_Changed"/>
            </WrapPanel>
            <TextBox x:Name="NoteEditor" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     TextAlignment="Left" VerticalContentAlignment="Top"
                     MinHeight="260" Padding="8" FontSize="13"
                     TextChanged="NoteEditor_TextChanged" LostFocus="NoteEditor_LostFocus"/>
            <TextBlock x:Name="NoteStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="2,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>