<UserControl x:Class="XCL2.App.Views.Tools.ServerPortScanTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="ServerPortScanTool_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,12,4,4" MaxWidth="760" HorizontalAlignment="Stretch">
            <TextBlock Text="服务器端口探测" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="对一个或多个 IP 探测 TCP 端口。连接成功表示端口开放；是否为 Minecraft 服务，可再用“服务器测速”确认。"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12"/>
            <StackPanel x:Name="ScanInputsPanel">
                <TextBlock Text="IP 地址" Margin="0,0,0,4"/>
                <TextBox x:Name="ScanAddressesBox" Text="127.0.0.1" AcceptsReturn="True" Height="90" Padding="8,6"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="ScanInput_Changed"
                         AutomationProperties.Name="要探测的 IP 地址，可输入多个"
                         ToolTip="IPv4 或 IPv6，多个地址用换行、逗号、分号或空格分隔；重复地址只探测一次。最多 64 个 IP。"/>
                <TextBlock Text="支持 IPv4、IPv6；多个 IP 用换行、逗号或空格分隔，重复地址自动合并。"
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                <WrapPanel>
                    <StackPanel Width="136" Margin="0,0,10,10">
                        <TextBlock Text="开始端口" Margin="0,0,0,4"/>
                        <TextBox x:Name="ScanStartPortBox" Text="25560" Padding="8,6" TextChanged="ScanInput_Changed"
                                 AutomationProperties.Name="开始端口" ToolTip="1–65535，包含开始端口"/>
                    </StackPanel>
                    <StackPanel Width="136" Margin="0,0,10,10">
                        <TextBlock Text="结束端口" Margin="0,0,0,4"/>
                        <TextBox x:Name="ScanEndPortBox" Text="25570" Padding="8,6" TextChanged="ScanInput_Changed"
                                 AutomationProperties.Name="结束端口" ToolTip="1–65535，包含结束端口，不能小于开始端口"/>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,0,10">
                        <TextBlock Text="最大端口数量（每个 IP）" Margin="0,0,0,4"/>
                        <TextBox x:Name="ScanMaximumPortsBox" Text="11" Padding="8,6" TextChanged="ScanInput_Changed"
                                 AutomationProperties.Name="每个 IP 最多探测多少个端口"
                                 ToolTip="1–65535。从开始端口升序探测，达到数量上限或结束端口即停止；开放和未开放的端口都计入数量。"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="ScanPlanText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <WrapPanel Margin="0,0,0,10">
                <Button x:Name="ScanStartButton" Content="开始探测" Padding="14,7" Margin="0,0,8,6"
                        Style="{StaticResource PrimaryButton}" Click="ScanStart_Click"/>
                <Button x:Name="ScanCancelButton" Content="取消" Padding="14,7" Margin="0,0,8,6"
                        IsEnabled="False" Click="ScanCancel_Click"/>
                <Button x:Name="ScanCopyButton" Content="复制开放端口列表" Padding="14,7" Margin="0,0,0,6"
                        IsEnabled="False" Click="ScanCopy_Click"/>
            </WrapPanel>
            <ProgressBar x:Name="ScanProgressBar" Height="6" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,8"
                         AutomationProperties.Name="端口探测进度"/>
            <TextBlock x:Name="ScanStatusText" Text="尚未开始探测。" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"/>
            <TextBlock x:Name="ScanCountsText" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="ScanErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="开放的 TCP 端口" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DataGrid x:Name="ScanResultsGrid" Height="240" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="开放端口及 TCP 连接耗时">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP : 端口" Binding="{Binding Endpoint}" Width="*" MinWidth="180"/>
                    <DataGridTextColumn Header="连接耗时" Binding="{Binding Elapsed}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ScanResultLimitText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11"
                       Text="开放端口较多，列表及复制保留最先发现的 5000 条；上方统计包含全部结果。可缩小范围再次探测。"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
            <TextBlock Text="每个连接最多等待约 800 毫秒；超时表示本次未收到响应，不等同于端口关闭。离开此工具会取消正在进行的探测。"
                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
