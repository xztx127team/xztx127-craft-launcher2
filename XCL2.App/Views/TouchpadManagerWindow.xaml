<local:OverlayDialogControl x:Class="XCL2.App.Views.TouchpadManagerWindow"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:local="clr-namespace:XCL2.App.Views"
                           MinWidth="600" MaxWidth="600" MinHeight="360" MaxHeight="580">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="触摸板" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
        <StackPanel Grid.Row="1" Margin="0,8,0,12">
            <TextBlock Text="选择游戏，或勾选“显示所有已知窗口”后选择其他应用窗口，再点击“开启触摸板”。开启后切回目标窗口即可使用；关闭触摸板后，目标程序继续运行。"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock Text="26.3 第 4 快照及以后使用新版触控；第 3 快照及以前使用兼容模式。若旧版游戏已在运行，再临时开启触控，请先在游戏鼠标设置中关闭“原始输入”（若有此选项）。由 XCL2 以触屏模式启动已识别的旧版会自动处理，并在退出后恢复。"
                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <CheckBox x:Name="ShowAllWindowsCheck" Content="显示所有已知窗口" IsChecked="False" Margin="0,8,0,0"
                      Checked="ShowAllWindowsCheck_Changed" Unchecked="ShowAllWindowsCheck_Changed"
                      ToolTip="列出可见应用窗口并标记当前前台窗口，可为选中的外部窗口单独开启触摸板。收起列表后仍保留已开启的窗口，方便关闭。"/>
            <TextBlock x:Name="SummaryText" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12" MinHeight="80">
            <ListBox x:Name="InstanceListBox" SelectionMode="Single"
                     Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="InstanceListBox_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding TitleLine}" ToolTip="{Binding TitleLine}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DetailLine}" Margin="0,5,0,0" FontSize="11"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding LocationLine}" ToolTip="{Binding LocationLine}"
                                           Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ErrorText}" Visibility="{Binding ErrorVisibility}"
                                           Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Top" Padding="8,4" CornerRadius="4"
                                    Background="{DynamicResource SideBrush}">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHint" Text="暂无正在运行的游戏实例&#x0a;启动游戏后，可在这里管理触摸板。"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" IsHitTestVisible="False"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="按键设置" Padding="12,8" Margin="0,0,8,0" Click="SettingsButton_Click"/>
            <Button x:Name="EnableButton" Content="开启触摸板" Style="{StaticResource PrimaryButton}"
                    Padding="14,8" Margin="0,0,8,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="EnableButton_Click"/>
            <Button x:Name="DisableButton" Content="关闭触摸板" Style="{StaticResource SideNavButton}"
                    Padding="14,8" Margin="0,0,8,0" IsEnabled="False" Click="DisableButton_Click"/>
            <Button Content="完成" Style="{StaticResource SideNavButton}" Padding="14,8" Click="DoneButton_Click"/>
        </StackPanel>
    </Grid>
</local:OverlayDialogControl>
