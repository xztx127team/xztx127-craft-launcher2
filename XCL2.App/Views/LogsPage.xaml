<UserControl x:Class="XCL2.App.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Str_Nav_Logs}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <CheckBox x:Name="ShowLogCheck" Grid.Column="1" Content="显示日志" ToolTip="{DynamicResource Str_Ui_Show_The_Log_Panel_Hidden_By_Default_Tic}"
                          Margin="12,0" VerticalAlignment="Center" Checked="ShowLogCheck_Changed" Unchecked="ShowLogCheck_Changed"/>
                <Button Grid.Column="2" Content="更多 ▾" Padding="10,5" Click="OpenButtonMenu_Click">
                    <Button.ContextMenu><ContextMenu>
                        <MenuItem Header="阅读字号与视图筛选…" Click="LogReading_Click"/>
                        <MenuItem Header="日志离线帮助…" Click="LogHelp_Click"/>
                        <Separator/>
                        <MenuItem Header="预览并导出诊断包…" Click="ExportDiagnostics_Click"/>
                        <MenuItem Header="本次会话任务结果…" Click="TaskResults_Click"/>
                    </ContextMenu></Button.ContextMenu>
                </Button>
            </Grid>

            <TextBlock x:Name="LogFilterNotice" Grid.Row="1" Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid Grid.Row="2" Visibility="{Binding Visibility, ElementName=LogTabs}">
                <TabControl x:Name="LogTabs" Visibility="Collapsed">
                    <TabItem Header="{DynamicResource Str_Ui_Game_Log}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProcessCombo" Grid.Column="0" MinWidth="120" Margin="0,0,8,0" SelectionChanged="ProcessCombo_SelectionChanged"/>
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource SideNavButton}" Padding="10,5" Click="RefreshGameLog_Click"/>
                                <Button Grid.Column="2" Content="复制" ToolTip="复制脱敏后的内容" Style="{StaticResource SideNavButton}" Padding="10,5" Margin="8,0,0,0" Click="CopyCurrentGameLog_Click"/>
                                <Button Grid.Column="3" Content="更多 ▾" Style="{StaticResource SideNavButton}" Padding="10,5" Margin="8,0,0,0" Click="OpenButtonMenu_Click">
                                    <Button.ContextMenu><ContextMenu>
                                        <MenuItem Header="AI 分析当前日志" Click="AnalyzeCurrentGameLogWithAi_Click"/><MenuItem Header="清空本视图" Click="ClearGameLogView_Click"/>
                                    </ContextMenu></Button.ContextMenu>
                                </Button>
                            </Grid>
                            <TextBox x:Name="GameLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{DynamicResource Str_Ui_Launcher_Log}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource SideNavButton}" Padding="10,5" Click="RefreshLauncherLog_Click"/>
                                <Button Grid.Column="2" Content="复制" ToolTip="复制脱敏后的内容" Style="{StaticResource SideNavButton}" Padding="10,5" Margin="8,0,0,0" Click="CopyLauncherLog_Click"/>
                                <Button Grid.Column="3" Content="更多 ▾" Style="{StaticResource SideNavButton}" Padding="10,5" Margin="8,0,0,0" Click="OpenButtonMenu_Click">
                                    <Button.ContextMenu><ContextMenu>
                                        <MenuItem Header="AI 分析日志" Click="AnalyzeLauncherLogWithAi_Click"/>
                                    </ContextMenu></Button.ContextMenu>
                                </Button>
                            </Grid>
                            <TextBox x:Name="LauncherLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        </Grid>
                    </TabItem>

                <TabItem Header="{DynamicResource Str_Ui_Crash_Report_Analysis}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CrashFileCombo" Grid.Column="0" MinWidth="120" Margin="0,0,8,0" SelectionChanged="CrashFileCombo_SelectionChanged"/>
                                <Button Grid.Column="1" Content="刷新" Style="{StaticResource SideNavButton}" Padding="10,5" Click="RescanCrash_Click"/>
                                <Button Grid.Column="2" Content="复制" ToolTip="复制脱敏后的内容" Style="{StaticResource SideNavButton}" Padding="10,5" Margin="8,0,0,0" Click="CopyCrashLog_Click"/>
                                <Button Grid.Column="3" Content="更多 ▾" Style="{StaticResource SideNavButton}" Padding="10,5" Margin="8,0,0,0" Click="OpenButtonMenu_Click">
                                    <Button.ContextMenu><ContextMenu>
                                        <MenuItem Header="AI 分析崩溃报告" Click="AnalyzeCrashLogWithAi_Click"/>
                                    </ContextMenu></Button.ContextMenu>
                                </Button>
                            </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource WarningBannerBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <TextBlock x:Name="CrashFindingsText" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{DynamicResource Str_Ui_Pick_A_Crash_File_Above_And_The_Automati}"/>
                        </Border>
                        <TextBox x:Name="CrashRawBox" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Str_Ui_Injection_Scan}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ScanProcessCombo" Grid.Column="0" MinWidth="120" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="扫描" Style="{StaticResource SideNavButton}" Padding="10,5" Click="ScanNow_Click"/>
                                <Button Grid.Column="2" Content="复制" ToolTip="复制脱敏后的内容" Style="{StaticResource SideNavButton}" Padding="10,5" Margin="8,0,0,0" Click="CopyInjectionLog_Click"/>
                                <Button Grid.Column="3" Content="更多 ▾" Style="{StaticResource SideNavButton}" Padding="10,5" Margin="8,0,0,0" Click="OpenButtonMenu_Click">
                                    <Button.ContextMenu><ContextMenu>
                                        <MenuItem Header="AI 分析扫描结果" Click="AnalyzeInjectionLogWithAi_Click"/>
                                    </ContextMenu></Button.ContextMenu>
                                </Button>
                            </Grid>
                        <!-- 修复"注入检测结果列表不管深色/浅色主题永远是白底黑字"：ListView 在这个项目里
                             没有任何全局隐式样式（跟 Button/CheckBox/ComboBox 不一样，App.xaml 里没有
                             针对 ListView/GridView 的模板），所以走的是 WPF 默认的系统 Aero 白色列表样式，
                             完全不跟随 ThemeService 切换的深浅色/色系。这里显式绑定面板画刷 + 文字画刷，
                             并给 ListViewItem/GridViewColumnHeader 各自补一个跟随主题的最小样式，
                             让这个列表跟页面其它地方一样能正确显示深色模式。 -->
                        <ListView x:Name="ModuleListView" Grid.Row="1"
                                  Background="{DynamicResource PanelBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource SideBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Risk}" Width="70" DisplayMemberBinding="{Binding RiskLabel}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Module_File}" Width="180" DisplayMemberBinding="{Binding FileName}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Matched_Rule}" Width="200" DisplayMemberBinding="{Binding MatchedRule}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Vendor}" Width="120" DisplayMemberBinding="{Binding CompanyName}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Ui_Path}" Width="260" DisplayMemberBinding="{Binding FullPath}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Str_Ui_Full_Launcher_Log}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,8,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="刷新" Padding="10,5" Click="RefreshFullLauncherLog_Click"/>
                            <Button Grid.Column="2" Content="复制" ToolTip="复制脱敏后的内容" Padding="10,5" Margin="8,0,0,0" Click="CopyFullLauncherLog_Click"/>
                            <Button Grid.Column="3" Content="更多 ▾" Padding="10,5" Margin="8,0,0,0" Click="OpenButtonMenu_Click">
                                <Button.ContextMenu><ContextMenu>
                                    <MenuItem Header="AI 分析完整日志" Click="AnalyzeFullLauncherLogWithAi_Click"/>
                                    <MenuItem Header="在独立窗口查看" Click="OpenLauncherLogInIndependentWindow_Click"/>
                                </ContextMenu></Button.ContextMenu>
                            </Button>
                        </Grid>
                        <TextBox x:Name="FullLauncherLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </Grid>
                </TabItem>
                </TabControl>
            </Grid>

            <TextBlock x:Name="HiddenHint" Grid.Row="2" Text="{DynamicResource Str_Ui_The_Log_Panel_Is_Hidden_Tick_The_Box_Abo}"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,20,0,0"/>
        </Grid>
    </Border>
</UserControl>
